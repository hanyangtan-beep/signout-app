      "group": "Macroscopy",
      "placeholder": "1.5",
      "default": ""
    },
    {
      "id": "deepInked",
      "label": "Deep surface",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Inked",
        "Not inked"
      ],
      "default": "Inked"
    },
    {
      "id": "cystContents",
      "label": "Cyst contents",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Cheesy keratinous material",
        "Hair and sebaceous material",
        "Ruptured"
      ],
      "default": "Cheesy keratinous material"
    },
    {
      "id": "blocks",
      "label": "Blocks",
      "type": "number",
      "group": "Macroscopy",
      "min": 1,
      "step": 1,
      "default": "2"
    },
    {
      "id": "blockScheme",
      "label": "Sampling",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "All embedded",
        "Representative sections"
      ],
      "default": "All embedded"
    },
    {
      "id": "cystType",
      "label": "Cyst type",
      "type": "select",
      "options": [
        "Epidermal cyst",
        "Pilar (trichilemmal) cyst",
        "Dermoid cyst",
        "Hybrid cyst",
        "Ruptured cyst with no residual lining",
        "Steatocystoma"
      ],
      "default": "Epidermal cyst"
    },
    {
      "id": "rupture",
      "label": "Rupture with granulomatous reaction",
      "type": "select",
      "options": [
        "Absent",
        "Present"
      ],
      "default": "Absent"
    },
    {
      "id": "giantCells",
      "label": "Foreign body giant cells",
      "type": "select",
      "options": [
        "Absent",
        "Present"
      ],
      "default": "Absent"
    },
    {
      "id": "acuteInflammation",
      "label": "Acute inflammation / abscess",
      "type": "select",
      "options": [
        "Absent",
        "Present",
        "Abscess formation"
      ],
      "default": "Absent"
    },
    {
      "id": "neoplasia",
      "label": "Neoplasia",
      "type": "select",
      "options": [
        "No evidence of malignancy",
        "Proliferating trichilemmal tumour – see comment",
        "Malignancy – see comment"
      ],
      "default": "No evidence of malignancy"
    },
    {
      "id": "excision",
      "label": "Excision",
      "type": "select",
      "options": [
        "Complete",
        "Incomplete",
        "Not assessable"
      ],
      "default": "Complete"
    },
    {
      "id": "additionalNotes",
      "label": "Additional microscopy",
      "type": "textarea",
      "placeholder": "Free text appended to the microscopy for this part",
      "default": ""
    }
  ],
  "snippets": [
    {
      "id": "skin_cyst_cancer_template",
      "label": "Neoplasia in cyst — use the QMH skin cancer template",
