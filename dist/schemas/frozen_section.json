{
  "id": "frozen_section",
  "version": "2026.09",
  "name": "Frozen section",
  "shortName": "Frozen section",
  "label": "Frozen",
  "organ": "",
  "system": "Frozen",
  "kind": "frozen",
  "rank": 19,
  "aliases": [
    "FS",
    "intraoperative",
    "margin",
    "parathyroid",
    "lymph node",
    "ovarian mass",
    "nodule"
  ],
  "match": {
    "site": [
      "frozen",
      "FS",
      "intraoperative"
    ],
    "procedure": [
      "frozen",
      "FS",
      "intraoperative"
    ],
    "clinical": []
  },
  "specimenNoun": "frozen section",
  "maxParts": 26,
  "defaultParts": 1,
  "generator": "frozen",
  "style": {
    "british": true
  },
  "caseFields": [
    {
      "id": "fsPathologists",
      "label": "Frozen section reported by",
      "placeholder": "Prof. A Cheung / Dr. HY Tan",
      "help": "Printed in brackets above the intraoperative diagnosis lines."
    },
    {
      "id": "fsTime",
      "label": "Phone reported at (time)",
      "placeholder": "1321"
    },
    {
      "id": "fsDate",
      "label": "Phone reported on (date)",
      "placeholder": "13/05/2026"
    },
    {
      "id": "fsReportedTo",
      "label": "Reported to",
      "placeholder": "Dr Lee (OT 3)",
      "help": "Optional. Clinician names are allowed; never patient details."
    }
  ],
  "options": [
    {
      "id": "includeHeader",
      "label": "Section headers (SPECIMEN / MACROSCOPIC / INTRAOPERATIVE CONSULTATION / MICROSCOPIC / DIAGNOSIS)",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "macro",
      "label": "Generate the macroscopic description for each frozen part",
      "type": "checkbox",
      "default": true
    }
  ],
  "fields": [
    {
      "id": "specimenName",
      "label": "Specimen label as received",
      "type": "text",
      "placeholder": "Tongue, medial margin",
      "default": ""
    },
    {
      "id": "scenario",
      "label": "Scenario",
      "type": "select",
      "options": [
        "Margin",
        "Lymph node",
        "Parathyroid",
        "Ovarian / adnexal mass",
        "Nodule / mass",
        "Other"
      ],
      "optionLabels": {
        "Nodule / mass": "Nodule or mass (lung, thyroid, other)",
        "Other": "Tissue identification / other (free text)"
      },
      "default": "Margin"
    },
    {
      "id": "pieces",
      "label": "Number of pieces",
      "type": "number",
      "default": "1",
      "min": 1
    },
    {
      "id": "tissueDesc",
      "label": "Tissue as received",
      "type": "select",
      "options": [
        "tan coloured tissue",
        "fibrofatty tissue",
        "skin",
        "lymph node",
        "mucosa",
        "greyish tissue",
        "other"
      ],
      "default": "tan coloured tissue"
    },
    {
      "id": "tissueDescOther",
      "label": "Describe tissue",
      "type": "text",
      "placeholder": "brownish nodular tissue",
      "default": "",
      "showIf": {
        "field": "tissueDesc",
        "is": "other"
      }
    },
    {
      "id": "size",
      "label": "Measurement",
      "type": "text",
      "placeholder": "1 x 0.4 x 0.2 cm",
      "default": ""
    },
    {
      "id": "handling",
      "label": "Handling",
      "type": "select",
      "options": [
        "All embedded",
        "Bisected and all embedded",
        "Serially sectioned and all embedded",
        "Representative section taken"
      ],
      "default": "All embedded"
    },
    {
      "id": "blocks",
      "label": "Frozen blocks",
      "type": "number",
      "default": "1",
      "min": 1
    },
    {
      "id": "marginResult",
      "label": "Frozen result",
      "type": "select",
      "options": [
        "Negative",
        "Positive",
        "Close",
        "Dysplasia only",
        "Atypical, deferred"
      ],
      "optionLabels": {
        "Negative": "No malignancy",
        "Positive": "Carcinoma present at margin",
        "Close": "Negative, tumour close to margin",
        "Dysplasia only": "Dysplasia, no invasive malignancy",
        "Atypical, deferred": "Atypical cells, defer to paraffin"
      },
      "default": "Negative",
      "showIf": {
        "field": "scenario",
        "is": "Margin"
      }
    },
    {
      "id": "marginDistance",
      "label": "Distance to margin (mm)",
      "type": "number",
      "default": "",
      "min": 0,
      "showIf": {
        "field": "marginResult",
        "is": "Close"
      }
    },
    {
      "id": "dysplasiaGrade",
      "label": "Dysplasia grade",
      "type": "select",
      "options": [
        "Mild",
        "Moderate",
        "Severe",
        "High grade"
      ],
      "default": "Moderate",
      "showIf": {
        "field": "marginResult",
        "is": "Dysplasia only"
      }
    },
    {
      "id": "nodeResult",
      "label": "Frozen result",
      "type": "select",
      "options": [
        "Negative",
        "Macrometastasis",
        "Micrometastasis",
        "Deferred"
      ],
      "optionLabels": {
        "Negative": "Negative for malignancy",
        "Macrometastasis": "Metastatic carcinoma, macrometastasis (> 2 mm)",
        "Micrometastasis": "Metastatic carcinoma, micrometastasis (0.2–2 mm)",
        "Deferred": "Defer to paraffin"
      },
      "default": "Negative",
      "showIf": {
        "field": "scenario",
        "is": "Lymph node"
      }
    },
    {
      "id": "metSize",
      "label": "Largest metastatic focus (mm)",
      "type": "number",
      "default": "",
      "min": 0,
      "showIf": {
        "field": "nodeResult",
        "is": [
          "Macrometastasis",
          "Micrometastasis"
        ]
      }
    },
    {
      "id": "parathyroidResult",
      "label": "Frozen result",
      "type": "select",
      "options": [
        "Parathyroid, hypercellular",
        "Parathyroid, normocellular",
        "Thyroid tissue",
        "Lymph node",
        "Adipose tissue",
        "Thymic tissue"
      ],
      "default": "Parathyroid, hypercellular",
      "showIf": {
        "field": "scenario",
        "is": "Parathyroid"
      }
    },
    {
      "id": "ovaryResult",
      "label": "Frozen result",
      "type": "select",
      "options": [
        "Benign",
        "Borderline",
        "Malignant",
        "Deferred"
      ],
      "optionLabels": {
        "Deferred": "Defer to paraffin"
      },
      "default": "Benign",
      "showIf": {
        "field": "scenario",
        "is": "Ovarian / adnexal mass"
      }
    },
    {
      "id": "noduleResult",
      "label": "Frozen result",
      "type": "select",
      "options": [
        "Benign",
        "Malignant",
        "Deferred"
      ],
      "optionLabels": {
        "Deferred": "Defer to paraffin"
      },
      "default": "Benign",
      "showIf": {
        "field": "scenario",
        "is": "Nodule / mass"
      }
    },
    {
      "id": "tumourType",
      "label": "Tumour type / favoured diagnosis",
      "type": "text",
      "placeholder": "squamous cell carcinoma / mucinous cystadenoma / favour adenocarcinoma",
      "default": "",
      "showIf": {
        "field": "scenario",
        "is": [
          "Margin",
          "Lymph node",
          "Ovarian / adnexal mass",
          "Nodule / mass"
        ]
      }
    },
    {
      "id": "freeResult",
      "label": "Frozen diagnosis (free text)",
      "type": "text",
      "placeholder": "Fibrous tissue with chronic inflammation; no malignancy",
      "default": "",
      "showIf": {
        "field": "scenario",
        "is": "Other"
      }
    },
    {
      "id": "correlation",
      "label": "Paraffin correlation",
      "type": "select",
      "options": [
        "Concordant",
        "Discordant",
        "Deferred"
      ],
      "optionLabels": {
        "Concordant": "Paraffin confirms the frozen diagnosis",
        "Discordant": "Paraffin disagrees with the frozen diagnosis",
        "Deferred": "Diagnosis deferred at frozen section"
      },
      "default": "Concordant"
    },
    {
      "id": "discordanceReason",
      "label": "Reason for discordance",
      "type": "select",
      "options": [
        "Sampling",
        "Interpretation",
        "Technical"
      ],
      "default": "Sampling",
      "showIf": {
        "field": "correlation",
        "is": "Discordant"
      }
    },
    {
      "id": "paraffinDx",
      "label": "Final (paraffin) diagnosis",
      "type": "text",
      "placeholder": "Squamous cell carcinoma involving the margin",
      "default": "",
      "showIf": {
        "field": "correlation",
        "is": [
          "Discordant",
          "Deferred"
        ]
      }
    },
    {
      "id": "tissue",
      "label": "Paraffin microscopy: tissue seen",
      "type": "text",
      "placeholder": "squamous mucosa with underlying skeletal muscle",
      "default": "",
      "help": "Leave blank for the scenario default."
    },
    {
      "id": "additionalNotes",
      "label": "Additional microscopy",
      "type": "textarea",
      "placeholder": "Free text appended to the paraffin microscopy for this part",
      "default": ""
    }
  ],
