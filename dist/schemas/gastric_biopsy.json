      "id": "gastric_hp",
      "label": "H. pylori — eradication",
      "auto": {
        "flag": "hpNoIm"
      },
      "text": "Helicobacter pylori organisms are identified. Eradication therapy and confirmation of clearance are suggested if not already undertaken."
    },
    {
      "id": "gastric_hp_im",
      "label": "H. pylori with intestinal metaplasia",
      "auto": {
        "flag": "hpWithIm"
      },
      "text": "Helicobacter pylori is present together with intestinal metaplasia. Eradication therapy with subsequent re-assessment of the metaplastic mucosa is suggested."
    },
    {
      "id": "gastric_im_incomplete",
      "label": "Incomplete IM — risk comment",
      "auto": {
        "flag": "imIncompleteAlone"
      },
      "text": "Incomplete-type intestinal metaplasia is a recognised risk factor for gastric adenocarcinoma. Assessment of its extent on mapping biopsies (Sydney protocol) is suggested if not already performed."
    },
    {
      "id": "gastric_surveillance",
      "label": "High-stage OLGA / OLGIM — surveillance",
      "auto": {
        "flag": "olgaHigh"
      },
      "text": "Extensive / high-stage atrophic gastritis and intestinal metaplasia are associated with an increased risk of gastric adenocarcinoma; endoscopic surveillance at three-yearly intervals (MAPS II / BSG 2019) is suggested in the appropriate clinical context."
    },
    {
      "id": "gastric_mapping",
      "label": "Incomplete mapping — repeat Sydney biopsies",
      "auto": {
        "flag": "imNeedsMapping"
      },
      "text": "Intestinal metaplasia is present but the biopsies do not allow OLGA / OLGIM staging. Mapping biopsies according to the updated Sydney protocol (antrum x2, incisura, body x2) are suggested if surveillance is being considered."
    }
