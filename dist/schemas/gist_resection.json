  "snippets": [
    {
      "id": "gist_resection_molecular_pending",
      "label": "Molecular result to follow",
      "auto": {
        "field": "molecular",
        "is": "Requested; result to follow"
      },
      "text": "Mutation analysis for KIT and PDGFRA hot spots has been requested and will be issued as a supplementary report. The result guides tyrosine kinase inhibitor selection and dosing."
    },
    {
      "id": "gist_resection_sdhb_deficient",
      "label": "SDHB-deficient GIST",
      "auto": {
        "flag": "sdhDeficient"
      },
      "text": "Loss of SDHB expression indicates a succinate dehydrogenase-deficient GIST. These tumours are typically gastric, epithelioid or mixed, may be multifocal, often show lymph node metastasis, respond poorly to imatinib, and raise the possibility of Carney-Stratakis syndrome or Carney triad; germline SDHx testing and genetic counselling are advised. Mitotic rate and size predict behaviour less reliably in this group."
    },
    {
      "id": "gist_resection_pdgfra_d842v",
      "label": "PDGFRA D842V - imatinib resistant",
      "auto": {
        "field": "molecular",
        "is": "PDGFRA exon 18 D842V mutation"
      },
      "text": "The PDGFRA exon 18 D842V mutation confers primary resistance to imatinib; avapritinib is the recognised targeted option should systemic therapy be considered."
    },
    {
      "id": "gist_resection_rupture",
      "label": "Tumour rupture",
      "auto": {
        "flag": "rupture"
      },
      "text": "Tumour rupture is associated with a high risk of peritoneal recurrence irrespective of size and mitotic count, and is regarded as an indication for adjuvant therapy."
    },
    {
      "id": "gist_resection_kit_negative",
      "label": "KIT-negative GIST",
      "auto": {
        "flag": "kitNegative"
      },
      "text": "The tumour is negative for KIT (CD117). DOG1 positivity supports the diagnosis of GIST; KIT-negative GISTs are enriched for PDGFRA mutations and molecular testing is recommended."
    },
    {
      "id": "gist_resection_multifocal",
      "label": "Multifocal GIST - syndromic association",
      "auto": {
        "field": "focality",
        "is": "Multifocal"
      },
      "text": "Multifocal GIST raises the possibility of a syndromic association (neurofibromatosis type 1, SDH-deficient GIST or familial GIST syndrome); clinical correlation is advised."
    }
  ],
