        "hyperplasticPolyp": "Hyperplastic polyp",
        "traditionalSerrated": "Traditional serrated adenoma"
      },
      "default": "tubularAdenoma"
    },
    {
      "id": "dysplasia",
      "label": "Dysplasia",
      "type": "grade",
      "options": ["Not applicable", "No dysplasia", "Low grade dysplasia", "High grade dysplasia"],
      "default": "Low grade dysplasia",
      "optionsByField": {
        "field": "type",
        "map": {
          "tubularAdenoma": ["Low grade dysplasia", "High grade dysplasia"],
          "tubulovillousAdenoma": ["Low grade dysplasia", "High grade dysplasia"],
          "villousAdenoma": ["Low grade dysplasia", "High grade dysplasia"],
          "sessileSerrated": ["No dysplasia", "Low grade dysplasia", "High grade dysplasia"],
          "hyperplasticPolyp": ["Not applicable"],
          "traditionalSerrated": ["Low grade dysplasia", "High grade dysplasia"]
        }
      }
    },
    {
      "id": "customSpecimen",
      "label": "Specimen name override",
      "type": "text",
      "default": "",
      "placeholder": "e.g. Sigmoid polyp x2 (blank = \"<Site> polyp\")"
    },
    {
      "id": "comment",
      "label": "Additional comment",
      "type": "textarea",
      "default": "",
      "placeholder": "Appended to the microscopy sentence for this part"
    }
  ],
