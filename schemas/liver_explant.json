  {
   "id": "causeFeatures",
   "label": "Features of the cause",
   "type": "multiselect",
   "group": "Background liver",
   "options": [
    "Ground-glass hepatocytes",
    "Florid duct lesions",
    "Bile duct loss",
    "Periductal concentric fibrosis",
    "Copper-associated protein",
    "PAS-D-positive globules",
    "Mallory-Denk bodies"
   ],
   "default": [],
   "reference": {
    "title": "Features of the cause",
    "intro": "What confirms the pre-transplant cause, or points to another (Int J Organ Transplant Med 2017).",
    "columns": 2,
    "groups": [
     {
      "heading": "Ground-glass hepatocytes",
      "points": [
       "Finely granular, pale, glassy cytoplasm; chronic hepatitis B"
      ],
      "images": [
       {
        "src": "assets/reference/liver_biopsy/ground_glass.jpg",
        "caption": "Ground-glass hepatocytes with finely granular pale cytoplasm in chronic hepatitis B (H&E).",
        "credit": "Nephron, Wikimedia Commons (cropped)",
        "license": "CC BY-SA 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Ground_glass_hepatocytes_high_mag_cropped.jpg"
       }
      ]
     },
     {
      "heading": "Florid duct lesion",
      "points": [
       "Lymphocytes within the duct epithelium, often with epithelioid granulomas; primary biliary cholangitis"
      ],
      "images": [
       {
        "src": "assets/reference/liver_biopsy/pbc_duct_lesion.jpg",
        "caption": "Primary biliary cholangitis: a damaged bile duct with intraepithelial lymphocytes in a mixed portal infiltrate, with a poorly formed granuloma nearby (H&E).",
        "credit": "Nephron, Wikimedia Commons (cropped)",
        "license": "CC BY-SA 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Primary_biliary_cirrhosis_intermed_mag_2.jpg"
       }
      ]
     },
     {
      "heading": "Periductal concentric fibrosis",
      "points": [
       "Onion-skin fibrosis around a bile duct; primary sclerosing cholangitis"
      ],
      "images": [
       {
        "src": "assets/reference/liver_biopsy/psc_onion_skin.jpg",
        "caption": "Primary sclerosing cholangitis: a bile duct surrounded by concentric periductal (onion-skin) fibrosis (H&E).",
        "credit": "Worthington, Chapman, Orphanet J Rare Dis 2006, Fig 2 (cropped)",
        "license": "CC BY 2.0",
        "url": "https://ojrd.biomedcentral.com/articles/10.1186/1750-1172-1-41"
       }
      ]
     },
     {
      "heading": "Copper and copper-associated protein",
      "points": [
       "Periportal copper (rhodanine) or copper-associated protein (orcein); chronic cholestasis or Wilson disease"
      ],
      "images": [
       {
        "src": "assets/reference/liver_biopsy/copper_rhodanine.jpg",
        "caption": "Copper in periportal hepatocytes as coarse orange-brown granules (rhodanine, x200); here Wilson disease.",
        "credit": "Choi, Int J Mol Sci 2025, Fig 20",
        "license": "CC BY 4.0",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12387026/"
       }
      ]
     },
     {
      "heading": "Mallory-Denk bodies",
      "points": [
       "Ropy eosinophilic hepatocyte inclusions; steatohepatitis or chronic cholestasis"
      ],
      "images": [
       {
        "src": "assets/reference/liver_biopsy/mallory_denk_body.jpg",
        "caption": "Mallory-Denk body (circled): a ropy eosinophilic inclusion in a hepatocyte in steatohepatitis (H&E).",
        "credit": "Nephron, Wikimedia Commons (cropped)",
        "license": "CC BY-SA 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mallory_body_high_mag_cropped_annotated.jpg"
       }
      ]
     },
     {
      "heading": "PAS-D-positive globules and bile duct loss",
      "points": [
       "Periportal PAS-D-positive globules: alpha-1 antitrypsin deficiency",
       "Bile duct loss: count the portal tracts without a duct"
      ]
     }
    ]
   }
