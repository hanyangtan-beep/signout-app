  {
   "id": "bgFindings",
   "label": "Background liver",
   "type": "multiselect",
   "group": "Background liver",
   "options": [
    "None identified",
    "Fibrosis (specify extent, providing name of the scheme and assessment scale used)",
    "Cirrhosis",
    "Steatosis",
    "Steatohepatitis",
    "Iron overload",
    "Chronic hepatitis (specify aetiology)",
    "Other (specify)"
   ],
   "default": [
    "Cirrhosis"
   ],
   "reference": {
    "title": "Explant microscopy checklist",
    "intro": "Stage and grade the background, confirm the cause, then classify every nodule; the HCC synoptic carries the tumour (CAP HCC protocol 4.2.0.0; RCPath G050).",
    "columns": 2,
    "groups": [
     {
      "heading": "Background liver and cause",
      "points": [
       "Stage the fibrosis with a named system (the CAP protocol recommends Ishak) and grade the activity",
       "Confirm the pre-transplant cause or find another: ground-glass cells, steatohepatitis, duct lesions or loss, copper-associated protein, PAS-D globules and iron (Int J Organ Transplant Med 2017)"
      ]
     },
     {
      "heading": "Nodules",
      "points": [
       "Large regenerative nodule, low-grade or high-grade dysplastic nodule, or early HCC, by the International Working Party criteria (CAP)",
       "Low-grade against high-grade: portal tracts, nuclear-cytoplasmic ratio, atypia and mitoses (Hepat Mon 2016)",
       "Name small cell change and large cell change as such (RCPath G050)"
      ]
     },
     {
      "heading": "Tumour",
      "points": [
       "Hepatocellular carcinoma: \"Add HCC synoptic\" links the synoptic under the same letter; staging uses the viable tumour size (CAP)"
      ]
     },
     {
      "heading": "Incidental lesions",
      "points": [
       "Incidental HCC, cholangiocarcinoma and biliary intraepithelial neoplasia, found even in end-stage livers without biliary disease (Int J Organ Transplant Med 2017)"
      ]
     },
     {
      "heading": "Vessels, nodes and gallbladder",
      "points": [
       "Bland, organising or tumour thrombus; say whether macroscopic vascular invasion is confirmed microscopically (RCPath G050)"
      ]
     },
     {
      "heading": "Acute liver failure",
      "points": [
       "Extent and pattern of necrosis (submassive or massive), the zone and the regeneration"
      ]
     }
    ]
   }
  },
