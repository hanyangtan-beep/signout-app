   "reference": {
    "title": "Other lesions",
    "intro": "Fibrolamellar, biliary, metastatic and vascular lesions on targeted cores.",
    "columns": 3,
    "groups": [
     {
      "heading": "Fibrolamellar carcinoma",
      "points": [
       "Large eosinophilic cells with prominent nucleoli; pale and hyaline bodies",
       "Lamellar fibrosis, often not seen on a core; non-cirrhotic liver",
       "CK7 and CD68 positive"
      ],
      "images": [
       {
        "src": "assets/reference/liver_lesion_biopsy/flc_pale_bodies.jpg",
        "caption": "Fibrolamellar carcinoma: tumour cells with large nuclei and pale bodies (C, short arrows) and hyaline globules (D, long arrows) (H&E, x400).",
        "credit": "Takahashi, Surg Case Rep 2021, Fig 2 (cropped)",
        "license": "CC BY 4.0",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC8448801/"
       }
      ]
     },
     {
      "heading": "Intrahepatic cholangiocarcinoma",
      "points": [
       "Small-duct: non-mucinous cuboidal cells in a ductular or cord-like pattern; CRP, N-cadherin, CD56",
       "Large-duct: columnar, often mucinous cells; S100P, MUC5AC",
       "Immunohistochemistry does not separate it from a pancreatic or gastric metastasis"
      ],
      "images": [
       {
        "src": "assets/reference/liver_lesion_biopsy/icca_small_duct.jpg",
        "caption": "Small-duct intrahepatic cholangiocarcinoma: morphology (a) with CRP (b), N-cadherin (c) and CD56 (d) (x100).",
        "credit": "Wang, Front Oncol 2025, Fig 2",
        "license": "CC BY 4.0",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12535893/"
       }
      ]
     },
     {
      "heading": "Bile duct hamartoma",
      "points": [
       "Ducts of variable shapes and sizes, often rounded, in a fibrous stroma",
       "Differential: bile duct adenoma and metastatic adenocarcinoma"
      ],
      "images": [
       {
        "src": "assets/reference/liver_lesion_biopsy/bile_duct_hamartoma.jpg",
        "caption": "Bile duct hamartoma (von Meyenburg complex): ducts of variable shapes and sizes in a fibrous stroma (H&E).",
        "credit": "Haloui, Pan Afr Med J 2022, Fig 4",
        "license": "CC BY 4.0",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC9307921/"
       }
      ]
     },
     {
      "heading": "Metastatic colorectal adenocarcinoma",
      "points": [
       "CK20 and CDX2 positive; over 15% of mismatch-repair-deficient tumours lose CK20 or CDX2",
       "Growth at the liver interface: desmoplastic, replacement or pushing"
      ],
      "images": [
       {
        "src": "assets/reference/liver_lesion_biopsy/crc_met_growth_patterns.jpg",
        "caption": "Colorectal liver metastases: desmoplastic (a), replacement (b), pushing (c) and mixed (d) growth patterns (H&E).",
        "credit": "Zaharia, Cancers 2023, Fig 2",
        "license": "CC BY 4.0",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC9818232/"
       }
      ]
     },
     {
      "heading": "Epithelioid haemangioendothelioma",
      "points": [
       "Strands and nests of epithelioid cells with intracytoplasmic vacuoles in a myxohyaline stroma",
       "ERG, CD31, CD34; CAMTA1 in most, TFE3 in a minority",
       "May express keratin; on a core it can pass for granulation tissue"
      ],
      "images": [
       {
        "src": "assets/reference/liver_lesion_biopsy/ehe_ihc.jpg",
        "caption": "TFE3-rearranged EHE: CD34, CD31, ERG and FLI-1 (A-D) and TFE3 (E) positive; Ki-67 about 15% (F).",
        "credit": "Meng, Front Oncol 2025, Fig 3",
        "license": "CC BY 4.0",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11799294/"
       }
      ]
     },
     {
      "heading": "PEComa",
      "points": [
       "Epithelioid cells with granular eosinophilic to clear cytoplasm, with fat",
       "HMB45, Melan-A, SMA and cathepsin K; HepPar-1 and keratin negative"
      ],
      "images": [
       {
        "src": "assets/reference/liver_lesion_biopsy/pecoma.jpg",
        "caption": "Hepatic PEComa: cut surface (A), epithelioid cells with granular to clear cytoplasm and fat (B, H&E x200), HMB-45 (C), Melan-A (D), SMA (E) and CD34 (F).",
        "credit": "Ji, Front Oncol 2024, Fig 3",
        "license": "CC BY 4.0",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11361986/"
       }
      ]
     }
    ]
