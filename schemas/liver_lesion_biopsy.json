   "reference": {
    "title": "HCC grade (WHO)",
    "intro": "Three tiers (WHO, ICCR, RCPath); where the tumour is heterogeneous the worst grade is assigned (RCPath G050). CAP uses four (G1-G4).",
    "columns": 3,
    "groups": [
     {
      "heading": "Well differentiated",
      "points": [
       "Cells resemble mature hepatocytes, with minimal to mild atypia",
       "Differential: high-grade dysplastic nodule (cirrhosis) or adenoma (non-cirrhotic liver)"
      ],
      "images": [
       {
        "src": "assets/reference/liver_lesion_biopsy/hcc_well_he.jpg",
        "caption": "Well-differentiated HCC: trabecular and pseudoglandular growth with mild atypia and bile pigment in the lumina (H&E, x400).",
        "credit": "Limaiem, Int J Surg Case Rep 2025, Fig 5",
        "license": "CC BY 4.0",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12410352/"
       }
      ]
     },
     {
      "heading": "Moderately differentiated",
      "points": [
       "Clearly malignant; the morphology strongly suggests hepatocellular differentiation",
       "Moderate nuclear atypia; occasional multinucleated cells"
      ],
      "images": [
       {
        "src": "assets/reference/liver_lesion_biopsy/hcc_moderate_biopsy_he.jpg",
        "caption": "Moderately differentiated HCC on a liver biopsy: pleomorphic hepatocytes with granular eosinophilic cytoplasm and prominent nucleoli (H&E, x400).",
        "credit": "Lukoo, Case Rep Radiol 2026, Fig 1",
        "license": "CC BY 4.0",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC13389434/"
       }
      ]
     },
     {
      "heading": "Poorly differentiated",
      "points": [
       "Clearly malignant, but the hepatocellular nature is not evident from the morphology",
       "Marked pleomorphism; anaplastic giant cells"
      ],
      "images": [
       {
        "src": "assets/reference/liver_lesion_biopsy/hcc_poor_biopsy_he.jpg",
        "caption": "Poorly differentiated HCC on a liver biopsy: sheets of markedly atypical cells with multinucleated giant cells and necrosis (H&E).",
        "credit": "Singh, Cureus 2025, Fig 3",
        "license": "CC BY 4.0",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12825689/"
       }
      ]
     }
    ]
   }
