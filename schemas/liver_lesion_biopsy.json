    "title": "Adenoma subtypes",
    "intro": "Glutamine synthetase, serum amyloid A and beta-catenin identify the clinically important inflammatory and beta-catenin-activated types (RCPath G050).",
    "columns": 3,
    "groups": [
     {
      "heading": "HNF1A-inactivated",
      "points": [
       "Steatosis, with ballooned or clear hepatocytes",
       "Loss of LFABP"
      ],
      "images": [
       {
        "src": "assets/reference/liver_lesion_biopsy/hca_hnf1a_lfabp.jpg",
        "caption": "HNF1A-inactivated adenoma: steatosis (a, c) and loss of LFABP (b).",
        "credit": "Margolskee, Diagn Pathol 2016, Fig 1",
        "license": "CC BY 4.0",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4784347/"
       }
      ]
     },
     {
      "heading": "Inflammatory",
      "points": [
       "Telangiectasia, ductular reaction and inflammation",
       "Diffuse strong SAA and CRP"
      ],
      "images": [
       {
        "src": "assets/reference/liver_lesion_biopsy/hca_inflammatory_saa.jpg",
        "caption": "Inflammatory adenoma: telangiectasia and inflammation (a, c) with diffuse serum amyloid A (b).",
        "credit": "Margolskee, Diagn Pathol 2016, Fig 3",
        "license": "CC BY 4.0",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4784347/"
       }
      ]
     },
     {
      "heading": "Beta-catenin-activated",
      "points": [
       "Exon 3: diffuse homogeneous glutamine synthetase, frequent nuclear beta-catenin; carries the risk of malignant change",
       "Exon 7/8: patchy or faint glutamine synthetase; no nuclear beta-catenin",
       "Glutamine synthetase not strong and diffuse on a biopsy: molecular testing decides"
      ],
      "images": [
       {
        "src": "assets/reference/liver_lesion_biopsy/hca_bcatenin_gs.jpg",
        "caption": "Beta-catenin-activated adenoma: diffuse glutamine synthetase against perivenular staining in normal liver (b), and focal nuclear beta-catenin (c, left).",
        "credit": "Margolskee, Diagn Pathol 2016, Fig 2",
        "license": "CC BY 4.0",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4784347/"
       }
      ]
     },
     {
      "heading": "Sonic hedgehog and unclassified",
      "points": [
       "Sonic hedgehog: bland small hepatocytes with haemorrhage and peliosis; ASS1 or PTGDS positive",
       "Unclassified: none of the above demonstrated"
      ],
      "images": []
     }
    ]
