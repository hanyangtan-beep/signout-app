{
  "id": "liver_benign",
  "version": "2026.09",
  "name": "Liver — benign lesion / abscess",
  "shortName": "Liver · wedge / partial hepatectomy",
  "label": "Liver lesion",
  "organ": "LIVER",
  "system": "Hepatobiliary",
  "kind": "benign resection",
  "rank": 40,
  "aliases": [
    "liver",
    "hepatectomy",
    "haemangioma",
    "hemangioma",
    "liver abscess",
    "FNH",
    "focal nodular hyperplasia",
    "hepatocellular adenoma",
    "liver cyst",
    "biliary cyst",
    "hydatid",
    "von Meyenburg",
    "wedge"
  ],
  "specimenNoun": "liver resection",
  "maxParts": 3,
  "defaultParts": 1,
  "generator": "liverbenign",
  "style": {
    "british": true
  },
  "caseFields": [],
  "options": [
    {
      "id": "includeHeader",
      "label": "Section headers (SPECIMEN / MICROSCOPIC EXAMINATION / DIAGNOSIS)",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "macro",
      "label": "Generate the macroscopic description and block key",
      "type": "checkbox",
      "default": true
    }
  ],
  "fields": [
    {
      "id": "specimenName",
      "label": "Specimen as received",
      "type": "text",
      "placeholder": "Liver, segment VI, wedge resection",
      "default": ""
    },
    {
      "id": "procedure",
      "label": "Procedure",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Wedge resection",
        "Segmentectomy",
        "Partial hepatectomy",
        "Enucleation",
        "Cyst deroofing"
      ],
      "default": "Wedge resection"
    },
    {
      "id": "segment",
      "label": "Segment / site as labelled",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "segment VI",
      "default": ""
    },
    {
      "id": "dimensions",
      "label": "Specimen size (cm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "6 x 5 x 3",
      "default": ""
    },
    {
      "id": "weight",
      "label": "Weight",
      "type": "number",
      "group": "Macroscopy",
      "min": 0,
      "step": 1,
      "suffix": "g",
      "default": ""
    },
    {
      "id": "capsule",
      "label": "Capsule",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Intact",
        "Disrupted",
        "Not applicable"
      ],
      "default": "Intact"
    },
    {
      "id": "lesionSize",
      "label": "Lesion size (cm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "3.5",
      "default": ""
    },
    {
      "id": "lesionDescription",
      "label": "Lesion appearance",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Spongy dark red",
        "Well-circumscribed tan",
        "Unilocular cyst with clear fluid",
        "Cavity with purulent material",
        "Central scar",
        "Other – describe"
      ],
      "default": "Spongy dark red"
    },
    {
      "id": "lesionOther",
      "label": "Lesion description",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "multilocular cyst containing mucoid material",
      "default": "",
      "showIf": {
        "field": "lesionDescription",
        "is": "Other – describe"
      }
    },
    {
      "id": "marginDistance",
      "label": "Distance to parenchymal margin (mm)",
      "type": "number",
      "group": "Macroscopy",
      "min": 0,
      "step": 1,
      "suffix": "mm",
      "default": ""
    },
    {
      "id": "backgroundMacro",
      "label": "Background liver (macro)",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Unremarkable",
        "Steatotic",
        "Cirrhotic"
      ],
      "default": "Unremarkable"
    },
    {
      "id": "blocks",
      "label": "Blocks",
      "type": "number",
      "group": "Macroscopy",
      "min": 1,
      "step": 1,
      "default": "5"
    },
    {
      "id": "lesionType",
      "label": "Lesion type",
      "type": "select",
      "options": [
        "Cavernous haemangioma",
        "Pyogenic abscess",
        "Simple biliary cyst",
        "Ciliated foregut cyst",
        "Biliary hamartoma (von Meyenburg complex)",
        "Focal nodular hyperplasia",
        "Hepatocellular adenoma",
        "Hydatid cyst",
        "Mucinous cystic neoplasm – see comment",
        "Malignant – see comment"
      ],
      "default": "Cavernous haemangioma"
    },
    {
      "id": "haemThrombosis",
      "label": "Thrombosis",
      "type": "checkbox",
      "default": false,
      "showIf": {
        "field": "lesionType",
        "is": "Cavernous haemangioma"
      }
    },
    {
      "id": "haemSclerosis",
      "label": "Sclerosis",
      "type": "checkbox",
      "default": false,
      "showIf": {
        "field": "lesionType",
        "is": "Cavernous haemangioma"
      }
    },
    {
      "id": "abscessOrganisms",
      "label": "Organisms on Gram / GMS / PAS",
      "type": "select",
      "options": [
        "Not identified",
        "Bacteria on Gram",
        "Fungal organisms on GMS / PAS",
        "Stains not performed"
      ],
      "default": "Not identified",
      "showIf": {
        "field": "lesionType",
        "is": "Pyogenic abscess"
      }
    },
    {
      "id": "amoebic",
      "label": "Amoebic pattern (trophozoites, scant neutrophils)",
      "type": "checkbox",
      "default": false,
      "showIf": {
        "field": "lesionType",
        "is": "Pyogenic abscess"
      }
    },
    {
      "id": "mcnIhc",
      "label": "ER / PR / inhibin positive in the stroma",
      "type": "checkbox",
      "default": true,
      "showIf": {
        "field": "lesionType",
        "is": "Mucinous cystic neoplasm – see comment"
      }
    },
    {
      "id": "fnhScar",
      "label": "Central scar present",
      "type": "checkbox",
      "default": true,
      "showIf": {
        "field": "lesionType",
        "is": "Focal nodular hyperplasia"
      }
    },
    {
      "id": "fnhGlutamineSynthetase",
      "label": "Map-like glutamine synthetase",
      "type": "checkbox",
      "default": false,
      "showIf": {
        "field": "lesionType",
        "is": "Focal nodular hyperplasia"
      }
    },
    {
      "id": "adenomaSubtype",
      "label": "Adenoma subtype",
      "type": "select",
      "options": [
        "HNF1A-inactivated – LFABP loss",
        "Inflammatory – SAA / CRP positive",
        "β-catenin-activated – nuclear β-catenin, diffuse glutamine synthetase",
        "Unclassified"
      ],
      "default": "HNF1A-inactivated – LFABP loss",
      "showIf": {
        "field": "lesionType",
        "is": "Hepatocellular adenoma"
      }
    },
    {
      "id": "protoscolices",
      "label": "Protoscolices / hooklets seen",
      "type": "checkbox",
      "default": false,
      "showIf": {
        "field": "lesionType",
        "is": "Hydatid cyst"
      }
    },
    {
      "id": "steatosis",
      "label": "Background steatosis",
      "type": "select",
      "options": [
        "None",
        "Mild (<33%)",
        "Moderate (33–66%)",
        "Severe (>66%)"
      ],
      "default": "None"
    },
    {
      "id": "fibrosis",
      "label": "Background fibrosis",
      "type": "select",
      "options": [
        "None",
        "Portal",
        "Periportal",
        "Bridging",
        "Cirrhosis"
      ],
      "default": "None"
    },
    {
      "id": "inflammation",
      "label": "Portal / lobular inflammation",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "margin",
      "label": "Parenchymal margin",
      "type": "select",
      "options": [
        "Completely excised",
        "Lesion reaches the parenchymal margin",
        "Not assessable"
      ],
      "default": "Completely excised"
    },
    {
      "id": "additionalNotes",
      "label": "Additional microscopy",
      "type": "textarea",
      "placeholder": "Free text appended to the microscopy for this part",
      "default": ""
    }
  ],
  "snippets": [
    {
      "id": "liver_mcn_template",
      "label": "Mucinous cystic neoplasm — use the QMH liver cystic neoplasm template",
      "auto": {
        "field": "lesionType",
        "is": "Mucinous cystic neoplasm – see comment"
      },
      "text": "A mucinous cystic neoplasm with ovarian-type stroma is identified in the liver ({parts}). This benign template does not grade the epithelium or stage the lesion; the QMH liver / biliary cystic neoplasm template should be used for the final report, documenting the grade of epithelial dysplasia and the presence or absence of an associated invasive carcinoma after complete sampling of the cyst wall."
    },
    {
      "id": "liver_beta_catenin_adenoma",
      "label": "β-catenin-activated adenoma — malignant potential",
      "auto": {
        "flag": "betaCateninAdenoma"
      },
      "text": "The hepatocellular adenoma shows beta-catenin activation ({parts}). Beta-catenin-activated hepatocellular adenomas carry a risk of malignant transformation to hepatocellular carcinoma; complete excision with clear margins and clinical follow-up are advised."
    },
    {
      "id": "liver_cancer_template",
      "label": "Malignant — use the QMH liver cancer template",
      "auto": {
        "field": "lesionType",
        "is": "Malignant – see comment"
      },
      "text": "A malignant neoplasm is identified in the liver ({parts}). This benign template does not type, grade or stage the tumour; the QMH liver cancer template should be used for the final synoptic report."
    }
  ],
