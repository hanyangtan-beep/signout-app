{
  "id": "pancreas_carcinoma",
  "version": "2026.10",
  "name": "Pancreatic carcinoma resection",
  "shortName": "Pancreas · carcinoma resection",
  "label": "Pancreas Ca",
  "organ": "Pancreas",
  "system": "Hepatobiliary",
  "kind": "cancer resection",
  "layout": {
    "macroGroups": [
      "Specimen and tumour"
    ],
    "macroFields": [
      "specimenName"
    ],
    "pack": true
  },
  "rank": 48,
  "aliases": [
    "whipple",
    "pancreaticoduodenectomy",
    "pancreatic cancer",
    "pdac",
    "ductal adenocarcinoma pancreas",
    "pancreatic head carcinoma",
    "ppppd",
    "distal pancreatectomy",
    "total pancreatectomy",
    "central pancreatectomy"
  ],
  "match": {
    "site": [
      "pancreas",
      "pancreatic head",
      "uncinate process",
      "pancreatic body",
      "pancreatic tail",
      "pancreaticoduodenectomy",
      "whipple",
      "pancreatectomy"
    ],
    "procedure": [
      "whipple",
      "pancreaticoduodenectomy",
      "pancreatectomy",
      "distal pancreas"
    ],
    "clinical": [
      "pancreatic carcinoma",
      "pancreatic cancer",
      "pdac",
      "ca pancreas",
      "ductal adenocarcinoma",
      "ipmn with invasion",
      "tail of pancreas",
      "body of pancreas",
      "pancreatic tail",
      "pancreatic body"
    ],
    "fill": [
      {
        "field": "specimenName",
        "from": "text",
        "unless": "^[^,]*$"
      },
      {
        "field": "procedure",
        "from": "map",
        "map": [
          [
            "\\btotal\\s+pancreatectomy\\b",
            "Total pancreatectomy"
          ],
          [
            "\\b(?:central|middle|median|segmental)\\s+pancreatectomy\\b",
            "Central pancreatectomy"
          ],
          [
            "\\benucleat(?:ion|ed)\\b",
            "Excisional biopsy (enucleation)"
          ],
          [
            "\\b(?:distal|left|subtotal)\\s+pancreatectomy\\b|\\bdistal\\s+pancreas\\b|\\bpancreas,\\s*(?:body\\s+and\\s+)?tail\\b|\\bpancreatic\\s+(?:body\\s+and\\s+)?tail\\b|\\btail\\s+of\\s+(?:the\\s+)?pancreas\\b|\\bramps\\b|\\bappleby\\b|\\bspleno-?pancreatectomy\\b|\\bpancreato-?splenectomy\\b",
            "Distal pancreatectomy"
          ],
          [
            "\\bpylorus[- ]preserving\\b|\\bpppd\\b|\\bpp-?pd\\b",
            "Pylorus-preserving pancreaticoduodenectomy"
          ],
          [
            "\\bwhipple|\\bpancreat(?:ic)?o-?duodenectomy\\b",
            "Pancreaticoduodenectomy (Whipple resection)"
          ]
        ]
      },
      {
        "field": "spleen",
        "from": "map",
        "map": [
          [
            "\\bspleen[- ]?(?:preserv\\w*|sparing)\\b|\\bsplenic\\s+preservation\\b|\\bpreserv\\w*\\s+(?:of\\s+)?(?:the\\s+)?spleen\\b|\\bkimura\\b|\\bwarshaw\\b",
            "Not included (spleen-preserving)"
          ],
          [
            "\\bspleen\\b|\\bsplenectomy\\b|\\bspleno-?pancreatectomy\\b|\\bpancreato-?splenectomy\\b|\\bramps\\b",
            "Included (splenectomy)"
          ]
        ]
      },
      {
        "field": "tumourSite",
        "from": "options"
      }
    ]
  },
  "macroExtract": {
    "specimenDims": {
      "concept": "specimenDims",
      "unit": "mm",
      "label": true
    },
    "pancreasDims": {
      "concept": "dims",
      "unit": "mm",
      "near": "pancreas|pancreatic head"
    },
    "duodenumLengthMm": {
      "concept": "length",
      "unit": "mm",
      "near": "duodenum"
    },
    "bileDuctLengthMm": {
      "concept": "length",
      "unit": "mm",
      "near": "bile duct|CBD"
    },
    "stomachLengthMm": {
      "concept": "length",
      "unit": "mm",
      "near": "stomach|gastric"
    },
    "tumourDims": {
      "concept": "tumourDims",
      "unit": "mm"
    },
    "blockKeyText": {
      "concept": "blockKey"
    },
    "spleenDims": {
      "concept": "dims",
      "unit": "mm",
      "near": "spleen"
    },
    "spleenWeightG": {
      "concept": "weight",
      "unit": "g",
      "near": "spleen"
    }
  },
  "specimenNoun": "resection",
  "maxParts": 6,
  "defaultParts": 1,
  "generator": "pancreas_carcinoma",
  "style": {
    "british": true
  },
  "source": {
    "template": "CAP Pancreas (Exocrine) protocol v4.3.0.0, June 2025 (required use March 2026)",
    "url": "https://documents.cap.org/documents/New-Cancer-Protocols-June-2025/Panc.Exo_4.3.0.0.REL_CAPCP.pdf",
    "staging": "AJCC 8th edition pTNM derived by src/staging/pancreas.js. pT1-pT3 are assigned on tumour size alone (T1a 0.5 cm or less, T1b over 0.5 up to 1 cm, T1c over 1 up to 2 cm, T2 over 2 up to 4 cm, T3 over 4 cm); extrapancreatic extension is recorded but does not raise pT. pT4 is arterial involvement only (coeliac axis, superior mesenteric artery or common hepatic artery) - venous involvement is not pT4 in this edition. pN1 is 1 to 3 involved nodes, pN2 is 4 or more. pTNM prints only with the printPTNM option, stamped (AJCC 8th edition). Treatment effect maps to the y descriptor automatically.",
    "stagingProtocol": "pancreas",
    "grading": "WHO 2019 digestive tumours histologic type and grade. Tumour size is in cm as in the CAP protocol; margin distances are in mm. Margins at 1 mm or less are reported as positive (R1) as is standard for pancreatobiliary resections.",
    "staging_reference": "https://digital.nhs.uk/ndrs/data/cancer-data-training-materials/staging-sheets/pancreas",
    "procedures": "Procedures, margins and node stations for the other pancreatectomies: ICCR Carcinoma of the Exocrine Pancreas dataset, 1st edition, and RCPath G091 dataset (distal pancreatectomy: proximal pancreatic transection margin and posterior surface; central pancreatectomy: both pancreatic transection margins; enucleation: the parenchymal margin; total pancreatectomy: no pancreatic transection). No node minimum is established for distal pancreatectomy, so the 12-node check runs for pancreatoduodenectomy and total pancreatectomy only."
  },
  "partDefaults": [],
  "options": [
    {
      "$use": "includeHeader",
      "label": "Section headers (SPECIMEN / MICROSCOPIC EXAMINATION AND SYNOPTIC REPORT / DIAGNOSIS)"
    },
    {
      "id": "macro",
      "label": "Generate the macroscopic description and block key",
      "type": "checkbox",
      "default": true
    },
    {
      "$use": "printPTNM"
    },
    {
      "$use": "printNodesMets"
    }
  ],
