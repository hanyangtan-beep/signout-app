  "fill": [
   {
    "field": "specimenType",
    "from": "map",
    "map": [
     [
      "^(?![\\s\\S]*(endometri|pipelle|curett|polypectomy|hysteroscop|d&c|uterine cavity))[\\s\\S]*(suction|vacuum|\\bMVA\\b)",
      "Uterus, suction evacuation"
     ],
     [
      "^(?![\\s\\S]*(endometri|pipelle|curett|polypectomy|hysteroscop|d&c|uterine cavity))[\\s\\S]*(evacuat|\\bE?RPO?C\\b|retained products)",
      "Uterus, evacuation of retained products of gestation"
     ],
     [
      "^(?![\\s\\S]*(endometri|pipelle|curett|polypectomy|hysteroscop|d&c|uterine cavity))[\\s\\S]*(vagin|passed|\\bPV\\b)",
      "Tissue mass, per vaginam"
     ],
     [
      "^(?![\\s\\S]*(endometri|pipelle|curett|polypectomy|hysteroscop|d&c|uterine cavity))[\\s\\S]*(tissue mass|products of (gestation|conception)|miscarriage)",
      "Tissue mass"
     ]
    ]
   },
   {
    "field": "phase",
    "from": "map",
    "map": [
     [
      "tissue mass|products of (gestation|conception)|retained products|evacuat|\\bE?RPO?C\\b|miscarriage|decidua",
      "Gestational (decidua and hypersecretory glands)"
     ]
    ]
   }
  ]
 },
