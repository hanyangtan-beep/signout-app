  {
   "id": "endo_ah_comment",
   "label": "Atypical hyperplasia / EIN comment",
   "auto": {
    "all": [
     {
      "field": "hyperplasia",
      "is": "Atypical hyperplasia / EIN"
     },
     {
      "field": "specimenType",
      "not": [
       "Tissue mass",
       "Tissue mass, per vaginam",
       "Uterus, suction evacuation",
       "Uterus, evacuation of retained products of gestation"
      ]
     }
    ]
   },
   "text": "Atypical hyperplasia / endometrioid intraepithelial neoplasia is associated with concurrent endometrioid carcinoma in a substantial proportion of subsequent hysterectomy specimens. Management in line with local gynaecological oncology guidelines is suggested."
  },
  {
   "id": "endo_scanty_comment",
   "label": "Scanty sample caveat",
   "auto": {
    "all": [
     {
      "field": "amount",
      "is": "Scanty (limited assessment)"
     },
     {
      "field": "specimenType",
      "not": [
       "Tissue mass",
       "Tissue mass, per vaginam",
       "Uterus, suction evacuation",
       "Uterus, evacuation of retained products of gestation"
      ]
     }
    ]
   },
   "text": "The sample is scanty and assessment of the endometrium is limited. Repeat sampling is suggested if clinically indicated."
  },
  {
   "id": "endo_mmr_lynch",
   "label": "MMR loss — Lynch follow-up",
   "auto": {
    "all": [
     {
      "field": "mmr",
      "is": [
       "Loss of MLH1 and PMS2",
       "Loss of MSH2 and MSH6",
       "Loss of MSH6",
       "Loss of PMS2"
      ]
     },
     {
      "field": "specimenType",
      "not": [
       "Tissue mass",
       "Tissue mass, per vaginam",
       "Uterus, suction evacuation",
       "Uterus, evacuation of retained products of gestation"
      ]
     }
    ]
   },
   "text": "Loss of mismatch repair protein expression is identified. MLH1 promoter hypermethylation testing (for MLH1 / PMS2 loss) or referral for genetic counselling and germline testing (for other patterns) is suggested."
  },
  {
   "id": "pog_partial_mole",
   "label": "Partial hydatidiform mole — ploidy and hCG follow-up",
   "auto": {
    "all": [
     {
      "field": "specimenType",
      "is": [
       "Tissue mass",
