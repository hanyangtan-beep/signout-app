   "reference": {
    "title": "WHO 5th Ewing sarcoma, FET::ETS confirmation & post-chemo necrosis",
    "intro": "Definitive diagnosis of Ewing sarcoma requires molecular confirmation of a FET::ETS fusion (most commonly EWSR1::FLI1 or EWSR1::ERG, rarely FUS::ETS) to separate it from CIC-rearranged, BCOR-altered, and EWSR1::non-ETS round cell sarcomas.",
    "note": "Photomicrographs are from Wikimedia Commons under open Creative Commons licences. ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Immunophenotype, molecular confirmation & therapy response",
      "points": [
       "Classic Ewing sarcoma: uniform sheets of small round blue cells with finely dispersed chromatin, glycogen-rich clear cytoplasm (PAS+), diffuse strong membranous CD99 and nuclear NKX2.2 positivity.",
       "Post-neoadjuvant chemotherapy response: map entire cross-section and report % necrosis (>= 90% or >= 95% necrosis / < 10% viable tumour indicates good histologic response).",
       "CIC-rearranged sarcomas (ETV4+, WT1+) and BCOR-altered sarcomas (BCOR+, SATB2+, cyclin D1+) are distinct WHO 5th entities with different clinical trajectories."
      ],
      "links": [
       {
        "label": "ExpertPath: Ewing Sarcoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/ewing_sarcoma/ewing_he.jpg",
        "caption": "Ewing sarcoma (high magnification): uniform sheets of small round blue cells with finely dispersed chromatin and scant clear cytoplasm (H&E).",
        "credit": "Nephron",
        "license": "CC BY-SA 3.0",
        "url": "https://commons.wikimedia.org/wiki/File%3AEwing_sarcoma_-_high_mag.jpg"
       }
      ]
     }
    ]
