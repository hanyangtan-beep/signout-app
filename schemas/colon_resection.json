  "snippets": [
    {
      "id": "colon_resection_few_nodes",
      "label": "Fewer than 12 lymph nodes",
      "auto": {
        "flag": "fewNodes"
      },
      "text": "Fewer than 12 regional lymph nodes were identified despite careful search of the mesenteric fat. Nodal staging should be interpreted with this in mind."
    },
    {
      "id": "colon_resection_mlh1_loss",
      "label": "MLH1 / PMS2 loss - BRAF / MLH1 methylation",
      "auto": {
        "field": "mmr",
        "is": "Loss of MLH1 and PMS2"
      },
      "text": "Loss of MLH1 and PMS2 expression indicates a mismatch repair deficient tumour. This pattern is most often sporadic (MLH1 promoter hypermethylation); BRAF V600E mutation or MLH1 promoter methylation testing is advised, with genetic counselling if both are negative."
    },
    {
      "id": "colon_resection_lynch",
      "label": "MSH2 / MSH6 / PMS2 pattern - Lynch referral",
      "auto": {
        "flag": "lynchPattern"
      },
      "text": "This pattern of mismatch repair protein loss raises the possibility of Lynch syndrome. Referral for genetic counselling and germline testing is advised."
    },
    {
      "id": "colon_resection_mmr_pending",
      "label": "MMR pending",
      "auto": {
        "field": "mmr",
        "is": "Pending"
      },
      "text": "Mismatch repair immunohistochemistry is in progress and will be issued as a supplementary report."
    },
    {
      "id": "colon_resection_crm_close",
      "label": "Rectal CRM 1 mm or less",
      "auto": {
        "flag": "crmClose"
      },
      "text": "The circumferential (radial) margin clearance is 1 mm or less, which is regarded as margin involvement for rectal carcinoma."
    },
    {
      "id": "colon_resection_override",
      "label": "pTNM overridden",
      "auto": {
        "field": "tnmOverride",
        "truthy": true
      },
      "text": "The pathological stage has been assigned by the pathologist and differs from the stage derived from the recorded elements; see the synoptic report for the reason."
    }
  ],
