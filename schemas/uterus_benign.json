      "auto": {
        "field": "endometrium",
        "is": [
          "Hyperplasia without atypia – see comment",
          "Atypical hyperplasia – see comment"
        ]
      },
      "text": "Endometrial hyperplasia is identified ({parts}). This benign template does not classify or stage endometrial neoplasia; the QMH endometrial cancer template should be used for the final synoptic report if carcinoma is identified on further sampling."
    },
    {
      "id": "uterus_cervix_template",
      "label": "HSIL — use the QMH cervix cancer template",
      "auto": {
        "field": "cervix",
        "is": "HSIL – see comment"
      },
      "text": "A high grade squamous intraepithelial lesion is identified in the cervix ({parts}). This benign template does not report margins or invasion; the cervix should be entirely embedded and the QMH cervix cancer template used if invasive carcinoma is identified."
    },
