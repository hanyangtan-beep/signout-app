      "perianal",
      "anal canal",
      "cyst",
      "abscess",
      "skin tag",
      "lipoma",
      "hidradenitis"
    ],
    "sideFromText": true,
    "fill": [
      {
        "field": "specimenName",
        "from": "text",
        "strip": "\\b(?:lesions?|mass|ulcers?|ulceration|radical\\s+(?:hemi-?)?vulvectomy|radical\\s+local\\s+excision|partial\\s+vulvectomy|hemi-?vulvectomy|simple\\s+vulvectomy|total\\s+vulvectomy|skinning\\s+vulvectomy|vulvectomy|wide\\s+local\\s+excision|wide\\s+excision|WLE|local\\s+excision|excision|resection|specimen|vulva[lr]?|c?SCC|squamous\\s+cell\\s+carcinoma|carcinoma|cancer|tumou?r)\\b",
        "unless": "^(?:left|right|midline|bilateral)$"
      },
      {
        "field": "procedure",
        "from": "map",
        "map": [
          [
            "\\bradical\\s+(?:hemi-?)?vulvectomy",
            "Radical vulvectomy"
          ],
          [
            "\\b(?:total|simple)\\s+vulvectomy",
            "Total vulvectomy"
          ],
          [
            "\\bpartial\\s+vulvectomy|\\bhemi-?vulvectomy",
            "Partial vulvectomy"
          ],
          [
            "\\bwide\\s+(?:local\\s+)?excision|\\bWLE\\b|\\bradical\\s+local\\s+excision",
            "Wide excision"
          ],
          [
            "\\b(?:local\\s+)?excision",
            "Local excision"
          ]
        ]
      },
      {
        "field": "tumourSite",
        "from": "map",
        "map": [
          [
            "\\blabi(?:um|a)\\s+maj(?:us|ora)\\b",
            "Labium majus"
          ],
          [
            "\\blabi(?:um|a)\\s+(?:maj(?:us|ora)\\s+(?:and|&)\\s+)?min(?:us|ora)\\b",
            "Labium minus"
          ],
          [
            "\\bbartholin",
            "Bartholin gland"
          ],
          [
            "\\bclitor",
            "Clitoris"
          ]
        ]
      }
    ]
  },
