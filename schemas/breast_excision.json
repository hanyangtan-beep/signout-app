 "fields": [
  {
   "id": "specimenName",
   "label": "Specimen as received",
   "type": "text",
   "placeholder": "Right breast superior margin, resection",
   "default": ""
  },
  {
   "id": "partType",
   "label": "Part type",
   "type": "select",
   "options": [
    "Cavity shave margin",
    "Breast lesion excision"
   ],
   "default": "Cavity shave margin"
  },
  {
   "id": "side",
   "label": "Side",
   "type": "select",
   "options": [
    "Right",
    "Left",
    "Not stated"
   ],
   "default": "Right"
  },
  {
   "id": "margin",
   "label": "Margin",
   "type": "select",
   "options": [
    "Superior",
    "Inferior",
    "Medial",
    "Lateral",
    "Anterior",
    "Posterior",
    "Other"
   ],
   "default": "Superior",
   "showIf": {
    "field": "partType",
    "is": "Cavity shave margin"
   }
  },
  {
   "id": "marginOther",
   "label": "Other margin name",
   "type": "text",
   "placeholder": "superolateral / deep / nipple",
   "default": "",
   "showIf": {
    "field": "margin",
    "is": "Other"
   }
  },
  {
   "id": "site",
   "label": "Site / lesion as labelled",
   "type": "text",
   "placeholder": "L3H breast mass",
   "default": "",
   "showIf": {
    "field": "partType",
    "is": "Breast lesion excision"
   }
  },
  {
   "id": "procedure",
   "label": "Procedure",
   "type": "select",
   "options": [
    "Excision",
    "Wide local excision",
    "Re-excision"
   ],
   "default": "Excision",
   "showIf": {
    "field": "partType",
    "is": "Breast lesion excision"
   }
  },
  {
   "id": "dimensions",
   "label": "Dimensions (cm)",
   "type": "text",
   "group": "Macroscopy",
   "placeholder": "4 x 3 x 1",
   "default": ""
  },
  {
   "id": "orientation",
   "label": "Orientation",
   "type": "select",
   "group": "Macroscopy",
   "options": [
    "Suture marks new margin",
    "Inked",
    "None"
   ],
   "default": "Suture marks new margin"
  },
  {
   "id": "lesion",
   "label": "Lesion on sectioning",
   "type": "select",
   "group": "Macroscopy",
   "options": [
    "None seen",
    "Firm nodule",
    "Cavity wall"
