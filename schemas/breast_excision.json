    "field": "lesion",
    "is": "Firm nodule"
   }
  },
  {
   "id": "blocks",
   "label": "Blocks",
   "type": "number",
   "group": "Macroscopy",
   "min": 1,
   "step": 1,
   "default": "3"
  },
  {
   "id": "blockKeyText",
   "label": "Block key (optional; overrides the automatic key)",
   "type": "text",
   "group": "Macroscopy",
   "placeholder": "(1-3) Serial slices, all embedded, new margin inked black.",
   "default": ""
  },
  {
   "id": "result",
   "label": "Result",
   "type": "select",
   "options": [
    "No evidence of malignancy (benign breast tissue)",
    "Fat necrosis",
    "Fibrocystic change",
    "Usual ductal hyperplasia",
    "Columnar cell change",
    "Sclerosing adenosis",
    "Intraductal papilloma",
    "Fibroadenoma",
    "Radial scar",
    "Flat epithelial atypia – see comment",
    "Atypical ductal hyperplasia – see comment",
    "DCIS – see comment",
    "Invasive carcinoma – see comment"
   ],
   "default": "No evidence of malignancy (benign breast tissue)"
  },
  {
   "id": "secondary",
   "label": "Background / secondary findings",
   "type": "multiselect",
   "options": [
    "None",
    "Usual ductal hyperplasia",
    "Fibrocystic change",
    "Columnar cell change",
    "Sclerosing adenosis",
    "Apocrine metaplasia",
    "Fat necrosis",
    "Duct ectasia"
   ],
   "exclusive": [
    "None"
   ],
   "default": [
    "None"
   ]
  },
  {
   "id": "calcification",
   "label": "Calcification",
   "type": "select",
   "options": [
    "Absent",
    "Present, benign",
    "Present, in DCIS"
   ],
   "default": "Absent"
  },
  {
   "id": "biopsySite",
   "label": "Biopsy site changes",
   "type": "select",
   "options": [
    "Absent",
    "Present"
   ],
   "default": "Absent"
  },
  {
   "id": "margins",
   "label": "Margins",
   "type": "select",
   "options": [
    "Clear",
    "Involved – which",
    "Close < 1 mm"
   ],
   "default": "Clear",
   "showIf": {
    "field": "partType",
    "is": "Breast lesion excision"
   }
  },
  {
   "id": "marginInvolved",
   "label": "Involved margin(s)",
   "type": "text",
   "placeholder": "medial",
   "default": "",
   "showIf": {
    "field": "margins",
    "is": "Involved – which"
   }
  },
  {
   "id": "additionalNotes",
   "label": "Additional microscopy",
   "type": "textarea",
   "placeholder": "Free text appended to the microscopy for this part",
   "default": ""
  }
 ],
