   "reference": {
    "title": "WHO 5th hypopharyngeal & HPV-independent oropharyngeal SCC variants",
    "intro": "Confirm HPV-independent status (p16 negative/patchy) for oropharyngeal primaries; p16-positive oropharyngeal SCC uses the separate HPV-associated staging system.",
    "note": "Photomicrographs are from Wikimedia Commons under open Creative Commons licences. ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Basaloid squamous cell carcinoma & conventional SCC",
      "points": [
       "Basaloid SCC: lobules of hyperchromatic basaloid cells with peripheral palisading, comedonecrosis and stromal hyalinisation; aggressive behaviour in hypopharynx/HPV-negative oropharynx.",
       "Conventional keratinising SCC: infiltrating nests with keratin pearls, intercellular bridges, desmoplasia and adjacent mucosal dysplasia."
      ],
      "links": [
       {
        "label": "ExpertPath: Hypopharyngeal Squamous Cell Carcinoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
