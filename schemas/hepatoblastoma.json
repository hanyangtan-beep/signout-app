   "reference": {
    "title": "Mandatory IHC panel in hepatoblastoma (INI1, Beta-catenin, Glypican-3)",
    "intro": "CAP 5.0.0.1 highlights three key immunostains: INI1 (SMARCB1) to exclude malignant rhabdoid tumour, nuclear beta-catenin (CTNNB1 pathway), and Glypican-3.",
    "note": "ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "INI1 (SMARCB1), Beta-catenin and Glypican-3",
      "points": [
       "INI1 (SMARCB1): retained in true hepatoblastoma; loss of nuclear INI1 in a small cell undifferentiated / rhabdoid tumour with low serum AFP (< 100 ng/mL) indicates malignant rhabdoid tumour of the liver.",
       "Beta-catenin: aberrant nuclear (and cytoplasmic) staining is seen in ~80\u201390% of hepatoblastomas.",
       "Glypican-3: fine granular cytoplasmic staining in fetal hepatoblastoma and coarse/diffuse positivity in embryonal areas."
      ],
      "links": [
       {
        "label": "ExpertPath: Hepatoblastoma",
        "url": "https://app.expertpath.com/"
       }
      ]
     }
