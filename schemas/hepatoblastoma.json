   "reference": {
    "title": "Hepatoblastoma histologic patterns (fetal, embryonal, mesenchymal, SCUD)",
    "intro": "Identify all epithelial and mesenchymal patterns present. Pure well-differentiated (mitotically inactive, <= 2 mitoses/10 HPF) fetal hepatoblastoma completely resected upfront has an excellent prognosis; small cell undifferentiated (SCUD) foci require INI1/SMARCB1 testing to exclude malignant rhabdoid tumour.",
    "note": "Photomicrographs are from Wikimedia Commons under open Creative Commons licences. ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Fetal pattern (well-differentiated vs crowded/mitotically active)",
      "points": [
       "Thin trabeculae/sheets of small uniform hepatoblasts with alternating clear (glycogen/lipid-rich) and eosinophilic cytoplasm ('light and dark' pattern) and extramedullary haematopoiesis.",
       "Well-differentiated fetal: <= 2 mitoses/10 HPF; crowded/mitotically active fetal: > 2 mitoses/10 HPF with amphophilic cytoplasm."
      ],
      "links": [
       {
        "label": "ExpertPath: Hepatoblastoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/hepatoblastoma/hb_low_mag.jpg",
        "caption": "Hepatoblastoma (low power): lobulated architecture with alternating light and dark fetal zones.",
        "credit": "Nephron",
        "license": "CC BY-SA 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hepatoblastoma_-_low_mag.jpg"
       },
       {
        "src": "assets/reference/hepatoblastoma/hb_fetal.jpg",
        "caption": "Hepatoblastoma (high power): uniform fetal hepatoblasts with round nuclei and alternating clear and eosinophilic cytoplasm.",
        "credit": "Nephron",
        "license": "CC BY-SA 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hepatoblastoma_-_high_mag.jpg"
       }
      ]
     },
     {
      "heading": "Embryonal pattern",
      "points": [
       "Sheets, ribbons, pseudorosettes and acini of angulated primitive cells with scant basophilic cytoplasm, high N:C ratio, coarse chromatin and frequent mitoses."
      ],
      "links": [
       {
        "label": "ExpertPath: Hepatoblastoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/hepatoblastoma/hb_embryonal.jpg",
        "caption": "Hepatoblastoma (embryonal pattern): primitive hepatoblasts with high nuclear-to-cytoplasmic ratio arranged in ribbons and nests.",
        "credit": "David C Chhieng",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hepatoblastoma.jpg"
       }
      ]
     },
     {
      "heading": "Mixed epithelial-mesenchymal & pleomorphic / rhabdoid patterns",
      "points": [
       "Mixed epithelial-mesenchymal hepatoblastoma contains osteoid-like matrix (very common post-chemotherapy!), spindle cell stroma, cartilage or skeletal muscle (teratoid if neuroectodermal/melanin/glandular elements present).",
       "Pleomorphic / rhabdoid or small cell undifferentiated patterns warrant INI1 (SMARCB1) IHC to exclude malignant rhabdoid tumour."
      ],
      "links": [
       {
        "label": "ExpertPath: Hepatoblastoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/hepatoblastoma/hb_mixed_mesenchymal.jpg",
        "caption": "High-grade / rhabdoid-like hepatoblastoma: evaluate INI1 (SMARCB1) nuclear expression whenever rhabdoid or small cell undifferentiated features are seen.",
        "credit": "Viola Salvestrini",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Adult_Hepatoblastoma_with_rhabdoid_features.jpg"
       }
      ]
     }
    ]
   }
