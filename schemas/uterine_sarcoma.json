   "reference": {
    "title": "WHO 5th classification of uterine sarcomas & diagnostic criteria",
    "intro": "Apply Stanford criteria for spindle leiomyosarcoma (>= 2 of: diffuse moderate-to-severe atypia, tumour cell necrosis, >= 10 mitoses/10 HPF) and distinct myxoid/epithelioid thresholds.",
    "note": "Photomicrographs are from Wikimedia Commons under open Creative Commons licences. ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Leiomyosarcoma (spindle, epithelioid, myxoid)",
      "points": [
       "Spindle LMS: >= 2 of diffuse moderate-to-severe cytologic atypia, coagulative tumour cell necrosis, and >= 10 mitoses / 10 HPF (4 mitoses/mm2).",
       "Myxoid LMS: lower thresholds (>= 1 of: moderate-to-severe atypia, tumour cell necrosis, > 1 mitosis/10 HPF, or infiltrative borders); Epithelioid LMS: >= 4 mitoses/10 HPF or tumour cell necrosis with atypia."
      ],
      "links": [
       {
        "label": "ExpertPath: Uterine Leiomyosarcoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/uterine_sarcoma/uterine_lms.jpg",
        "caption": "Uterine leiomyosarcoma: intersecting fascicles of atypical spindle cells with nuclear pleomorphism and mitotic figures (H&E).",
        "credit": "Eiji Kobayashi et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Histopathology_of_leiomyosarcoma.jpg"
       },
       {
        "src": "assets/reference/uterine_sarcoma/epithelioid_lms.jpg",
        "caption": "Epithelioid leiomyosarcoma of the uterus: sheets of round-to-polygonal epithelioid smooth muscle cells with nuclear atypia (H&E).",
        "credit": "Luke King et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Histopathology_of_epithelioid_leiomyosarcoma.jpg"
       }
      ]
     },
     {
      "heading": "Low-grade vs High-grade Endometrial Stromal Sarcoma",
      "points": [
       "LG-ESS: tongue-like myometrial/LVI infiltration of uniform small stromal cells with spiral-arteriole network; CD10+, ER+, PR+; JAZF1-SUZ12 or PHF1 fusions.",
       "HG-ESS: YWHAE-NUTM2A/B (round cell component, cyclin D1+, BCOR+, CD10/ER/PR-) or ZC3H7B-BCOR / BCOR ITD (myxoid spindle/round cells)."
      ],
      "links": [
       {
        "label": "ExpertPath: Endometrial Stromal Sarcoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/uterine_sarcoma/lg_ess.jpg",
        "caption": "Endometrial stromal sarcoma: uniform small oval-to-spindle stromal cells surrounding prominent spiral arteriole-like vessels (H&E).",
        "credit": "Nephron",
        "license": "CC BY-SA 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Endometrial_stromal_sarcoma_-_very_high_mag.jpg"
       }
      ]
     },
     {
      "heading": "Mullerian adenosarcoma & sarcomatous overgrowth",
      "points": [
       "Benign/atypical Mullerian epithelium with leaf-like/phyllodes architecture and condensed periglandular stromal cuffing.",
       "Sarcomatous overgrowth (>= 25% of tumour composed of pure high-grade sarcoma without epithelial component) carries a worse prognosis; note adenosarcoma uses a separate pT1a/b/c myometrial invasion staging track."
      ],
      "links": [
       {
        "label": "ExpertPath: Mullerian Adenosarcoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
