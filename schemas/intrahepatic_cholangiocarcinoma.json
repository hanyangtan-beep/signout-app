   "reference": {
    "title": "Intrahepatic cholangiocarcinoma staging landmarks (AJCC 8th Ch. 23)",
    "intro": "AJCC 8th edition splits solitary iCCA without vascular invasion at 5 cm (pT1a <= 5 cm, pT1b > 5 cm). Vascular invasion or multiple tumours (including satellite nodules) assign pT2.",
    "note": "ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "pT1a/b vs pT2 vs pT3 vs pT4",
      "points": [
       "pT1a (<= 5 cm) / pT1b (> 5 cm): solitary tumour without intrahepatic vascular invasion.",
       "pT2: solitary tumour WITH intrahepatic vascular invasion (micro- or macrovascular), OR multiple tumours (satellites/intrahepatic metastases).",
       "pT3: perforation of the visceral peritoneum (Glisson's capsule breached onto mesothelial surface).",
       "pT4: direct invasion of local extrahepatic structures (gallbladder, diaphragm, colon, stomach, IVC)."
      ],
      "links": [
