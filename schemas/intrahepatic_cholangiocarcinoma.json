   "reference": {
    "title": "Intrahepatic cholangiocarcinoma: small-duct vs large-duct subtypes (WHO 6th)",
    "intro": "WHO separates intrahepatic cholangiocarcinoma into small-duct type (peripheral, non-mucinous, IDH1/2 & FGFR2 alterations) and large-duct type (central/perihilar-like, mucin-producing, KRAS/TP53/SMAD4, BilIN precursor). Confirm biliary phenotype with CK7/CK19 and exclude metastatic adenocarcinoma and HCC.",
    "note": "Photomicrographs are from Wikimedia Commons under open Creative Commons licences. ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Small-duct vs Large-duct iCCA (H&E)",
      "points": [
       "Small-duct iCCA: peripheral mass-forming tumour with small non-mucinous tubules/ductules, low cuboidal cells, hyalinised stroma, CRP/N-cadherin/CD56+; enriched for actionable IDH1/2 mutations and FGFR2 fusions.",
       "Large-duct iCCA: central periductal-infiltrating or mass-forming mucinous columnar glands with frequent perineural invasion, S100P+, MUC5AC/MUC6+, and BilIN precursor."
      ],
      "links": [
       {
        "label": "ExpertPath: Intrahepatic Cholangiocarcinoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/intrahepatic_cholangiocarcinoma/icca_he_low.jpg",
        "caption": "Intrahepatic cholangiocarcinoma (low power): infiltrating biliary-type glands in abundant fibrous desmoplastic stroma.",
        "credit": "Nephron",
        "license": "CC BY-SA 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Cholangiocarcinoma_-_low_mag.jpg"
       },
       {
        "src": "assets/reference/intrahepatic_cholangiocarcinoma/icca_he_high.jpg",
        "caption": "Intrahepatic cholangiocarcinoma (intermediate power): anastomosing malignant ductular/glandular structures invading hepatic parenchyma.",
        "credit": "Nephron",
        "license": "CC BY-SA 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Cholangiocarcinoma_-_intermed_mag.jpg"
       }
      ]
     },
     {
      "heading": "Immunohistochemistry (CK7 / CK19) & combined HCC-CCA",
      "points": [
       "Typical iCCA profile: CK7+, CK19+, albumin ISH+ (often in small-duct type), HepPar1-, Arginase-1-, Glypican-3-.",
       "Combined hepatocellular-cholangiocarcinoma requires unequivocal hepatocytic AND cholangiocytic differentiation on H&E (not just focal CK19 in an otherwise typical HCC)."
      ],
      "links": [
       {
        "label": "ExpertPath: Combined Hepatocellular-Cholangiocarcinoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/intrahepatic_cholangiocarcinoma/icca_ck19.jpg",
        "caption": "CK19 IHC in cholangiocarcinoma: strong diffuse cytoplasmic staining in infiltrating biliary tumour glands.",
        "credit": "Mikael H\u00e4ggstr\u00f6m, M.D.",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Immunohistochemistry_for_CK19_in_metastatic_cholangiocarcinoma_to_the_liver.jpg"
       }
      ]
     }
    ]
   }
