   "reference": {
    "title": "PD-L1 IHC scoring algorithms (TPS, CPS & IC)",
    "intro": "Require at least 100 viable invasive tumour cells for adequacy. Score partial or complete linear membranous staining on tumour cells (exclude cytoplasmic-only staining and necrosis).",
    "note": "Photomicrographs are from Wikimedia Commons under open Creative Commons licences. ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Algorithm definitions & membranous expression spectrum",
      "points": [
       "TPS (NSCLC): % of viable tumour cells showing partial or complete membrane staining (< 1%, 1–49%, >= 50%).",
       "CPS (HNSCC, gastric, oesophageal, cervical, TNBC, urothelial): ([PD-L1+ tumour cells + mononuclear immune cells] / total viable tumour cells) x 100, capped at 100.",
       "IC (SP142): % of tumour area occupied by PD-L1+ tumour-infiltrating immune cells."
      ],
      "links": [
       {
        "label": "ExpertPath: PD-L1 Biomarker Testing",
        "url": "https://app.expertpath.com/"
       }
      ],
