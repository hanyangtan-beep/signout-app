   "reference": {
    "title": "Small intestine carcinoma histologic subtypes (WHO 5th)",
    "intro": "Report small intestinal adenocarcinoma subtypes per WHO 5th edition; screen for Lynch syndrome / MMR deficiency (especially medullary, mucinous, and Crohn-associated carcinomas).",
    "note": "Photomicrographs are from Wikimedia Commons under open Creative Commons licences. ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Adenocarcinoma, NOS (intestinal & pancreatobiliary-like)",
      "points": [
       "Irregular infiltrating glands with tall columnar cells, pseudostratified hyperchromatic nuclei, dirty luminal necrosis and desmoplastic stroma.",
       "Duodenal adenocarcinomas may show intestinal (CDX2+/CK20+) or pancreatobiliary/gastric (MUC1+/CK7+) immunophenotypes."
      ],
      "links": [
       {
        "label": "ExpertPath: Small Intestine Adenocarcinoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/small_intestine_carcinoma/si_adeno.jpg",
        "caption": "Small intestinal adenocarcinoma: infiltrating malignant glands within the bowel wall with desmoplastic stroma (H&E).",
        "credit": "Xilin Wu et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Light_microscopy_of_small_intestinal_adenocarcinoma.jpg"
       },
       {
        "src": "assets/reference/small_intestine_carcinoma/duodenal_adeno.jpg",
        "caption": "Periampullary / duodenal adenocarcinoma: crowded malignant glandular profiles with nuclear stratification and atypia (H&E).",
        "credit": "Nephron",
        "license": "CC BY-SA 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Periampullary_adenocarcinoma_--_high_mag.jpg"
       }
      ]
     },
     {
      "heading": "Mucinous adenocarcinoma (> 50% extracellular mucin)",
      "points": [
       "More than 50% of the lesion composed of pools of extracellular mucin containing malignant glandular epithelium, strips or signet-ring cells.",
       "Strongly associated with Lynch syndrome / dMMR and Crohn disease."
      ],
      "links": [
       {
        "label": "ExpertPath: Mucinous Adenocarcinoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/small_intestine_carcinoma/mucinous_adeno.jpg",
        "caption": "Mucinous adenocarcinoma: abundant extracellular mucin lakes containing strips and clusters of malignant glandular epithelium (H&E).",
        "credit": "Patho",
        "license": "CC BY-SA 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mucinous_adenocarcinoma_of_the_colon,_HE_5.JPG"
       }
      ]
     },
     {
      "heading": "Signet-ring cell & poorly cohesive carcinoma",
      "points": [
       "Signet-ring cell carcinoma: > 50% of tumour cells with prominent intracytoplasmic mucin displacing a crescentic nucleus to the periphery.",
       "Poorly cohesive carcinoma: single cells and cords without gland formation (< 50% classic signet-ring cells)."
      ],
      "links": [
       {
        "label": "ExpertPath: Signet-Ring Cell Carcinoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/small_intestine_carcinoma/signet_ring.jpg",
        "caption": "Signet-ring cell carcinoma of the ileum: discohesive cells with intracytoplasmic mucin vacuoles compressing eccentric nuclei (H&E).",
        "credit": "Hammami MB et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Histopathology_of_signet_ring_cell_carcinoma_of_ileum.jpg"
       }
      ]
     },
     {
      "heading": "Goblet cell / MiNEN differential",
      "points": [
       "MiNEN requires >= 30% of each distinct neuroendocrine and non-neuroendocrine component; confirm neuroendocrine component with synaptophysin, chromogranin A and INSM1."
      ],
      "links": [
       {
        "label": "ExpertPath: Mixed Neuroendocrine-Non-Neuroendocrine Neoplasm",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/small_intestine_carcinoma/goblet_cell.jpg",
        "caption": "Goblet cell adenocarcinoma (illustrated in appendix for morphological comparison): small mucin-filled nests infiltrating the wall (H&E).",
        "credit": "Sarahkayb",
        "license": "CC BY-SA 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Appendix_Carcinoid_GobletCell_MP_PA.JPG"
       }
      ]
     }
    ]
