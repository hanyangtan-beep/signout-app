{
  "id": "skin_lesion",
  "version": "2026.09",
  "name": "Skin — small benign lesion",
  "shortName": "Skin · shave / punch / small excision",
  "label": "Skin lesion",
  "organ": "SKIN",
  "system": "Skin",
  "kind": "benign resection",
  "rank": 37,
  "aliases": [
    "skin tag",
    "naevus",
    "nevus",
    "seborrhoeic keratosis",
    "pyogenic granuloma",
    "dermatofibroma",
    "verruca",
    "wart",
    "molluscum",
    "actinic keratosis",
    "neurofibroma",
    "haemangioma",
    "keloid",
    "xanthelasma",
    "shave",
    "punch",
    "curettage"
  ],
  "specimenNoun": "shave",
  "maxParts": 6,
  "defaultParts": 1,
  "generator": "skinlesion",
  "style": {
    "british": true
  },
  "caseFields": [],
  "options": [
    {
      "id": "includeHeader",
      "label": "Section headers (SPECIMEN / MICROSCOPIC EXAMINATION / DIAGNOSIS)",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "macro",
      "label": "Generate the macroscopic description and block key",
      "type": "checkbox",
      "default": true
    }
  ],
  "partDefaults": [],
  "fields": [
    {
      "id": "specimenName",
      "label": "Site",
      "type": "text",
      "placeholder": "left forearm",
      "default": ""
    },
    {
      "id": "procedure",
      "label": "Procedure",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Shave",
        "Punch",
        "Excision, ellipse",
        "Curettings"
      ],
      "default": "Shave"
    },
    {
      "id": "specimenSize",
      "label": "Specimen size (cm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "0.6 x 0.4 x 0.2",
      "default": ""
    },
    {
      "id": "lesionDescription",
      "label": "Lesion",
      "type": "multiselect",
      "group": "Macroscopy",
      "options": [
        "Papule",
        "Polypoid",
        "Nodule",
        "Pigmented",
        "Verrucous",
        "Ulcerated"
      ],
      "default": [
        "Papule"
      ]
    },
    {
      "id": "lesionSize",
      "label": "Lesion size (cm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "0.4",
      "default": ""
    },
    {
      "id": "deepInked",
      "label": "Deep surface inked",
      "type": "checkbox",
      "group": "Macroscopy",
      "default": true,
      "showIf": {
        "field": "procedure",
        "is": "Excision, ellipse"
      }
    },
    {
      "id": "blocks",
      "label": "Blocks",
      "type": "number",
      "group": "Macroscopy",
      "min": 1,
      "step": 1,
      "default": "1"
    },
    {
      "id": "lesionType",
      "label": "Lesion type",
      "type": "select",
      "options": [
        "Seborrhoeic keratosis",
        "Melanocytic naevus",
        "Skin tag / fibroepithelial polyp",
        "Pyogenic granuloma (lobular capillary haemangioma)",
        "Dermatofibroma",
        "Verruca vulgaris",
        "Molluscum contagiosum",
        "Actinic keratosis",
        "Neurofibroma",
        "Haemangioma",
        "Keloid / hypertrophic scar",
        "Xanthelasma",
        "Chondrodermatitis nodularis helicis",
        "Malignant / atypical – see comment"
      ],
      "default": "Seborrhoeic keratosis"
    },
    {
      "id": "skSubtype",
      "label": "Seborrhoeic keratosis subtype",
      "type": "select",
      "options": [
        "Acanthotic",
        "Hyperkeratotic",
        "Irritated",
        "Clonal",
        "Reticulated"
      ],
      "default": "Acanthotic",
      "showIf": {
        "field": "lesionType",
        "is": "Seborrhoeic keratosis"
      }
    },
    {
      "id": "pgUlceration",
      "label": "Surface ulceration",
      "type": "select",
      "options": [
        "Absent",
        "Present"
      ],
      "default": "Absent",
      "showIf": {
        "field": "lesionType",
        "is": "Pyogenic granuloma (lobular capillary haemangioma)"
      }
    },
    {
      "id": "naevusType",
      "label": "Naevus type",
      "type": "select",
      "options": [
        "Intradermal",
        "Compound",
        "Junctional"
      ],
      "default": "Intradermal",
      "showIf": {
        "field": "lesionType",
        "is": "Melanocytic naevus"
      }
    },
    {
      "id": "congenitalPattern",
      "label": "Congenital pattern",
      "type": "checkbox",
      "default": false,
      "showIf": {
        "field": "lesionType",
        "is": "Melanocytic naevus"
      }
    },
    {
      "id": "dysplasticFeatures",
      "label": "Dysplastic features",
      "type": "select",
      "options": [
        "None",
        "Mild"
      ],
      "default": "None",
      "showIf": {
        "field": "lesionType",
        "is": "Melanocytic naevus"
      }
    },
    {
      "id": "akGrade",
      "label": "Actinic keratosis grade",
      "type": "select",
      "options": [
        "KIN I",
        "KIN II",
        "KIN III"
      ],
      "default": "KIN I",
      "showIf": {
        "field": "lesionType",
        "is": "Actinic keratosis"
      }
    },
    {
      "id": "marginStatus",
      "label": "Margin status",
      "type": "select",
      "options": [
        "Not applicable – shave",
        "Completely excised",
        "Lesion extends to the edge of the shave",
        "Lesion extends to the lateral margin",
        "Involves deep margin"
      ],
      "default": "Not applicable – shave"
    },
    {
      "id": "closestMargin",
      "label": "Closest margin (mm)",
      "type": "number",
      "min": 0,
      "step": 0.5,
      "suffix": "mm",
      "default": "",
      "showIf": {
        "field": "procedure",
        "is": "Excision, ellipse"
      }
    },
    {
      "id": "additionalNotes",
      "label": "Additional microscopy",
      "type": "textarea",
      "placeholder": "Free text appended to the microscopy for this part",
      "default": ""
    }
  ],
  "snippets": [
    {
      "id": "skin_lesion_ak_margin",
      "label": "Actinic keratosis at margin — clinical follow-up",
      "auto": {
        "flag": "akMargin"
      },
      "text": "Actinic keratosis extends to the margin. Clinical follow-up of the site is recommended."
    },
    {
      "id": "skin_lesion_naevus_atypia",
      "label": "Naevus with atypia — complete excision advised",
      "auto": {
        "field": "dysplasticFeatures",
        "is": "Mild"
      },
      "text": "The melanocytic naevus shows mild dysplastic features ({parts}). Complete excision is advised for further evaluation."
    },
    {
      "id": "skin_lesion_cancer_template",
      "label": "Melanoma / SCC suspected — use the QMH skin cancer template",
      "auto": {
        "field": "lesionType",
        "is": "Malignant / atypical – see comment"
      },
      "text": "An atypical or malignant lesion is identified ({parts}). This benign template does not grade or stage the lesion; the QMH skin cancer template should be used for the final synoptic report."
    }
  ],
  "example": {
    "caseTitle": "",
    "options": {
      "includeHeader": false,
      "macro": true
    },
    "parts": [
      {
        "label": "A",
        "values": {
          "specimenName": "back",
          "procedure": "Excision, ellipse",
          "specimenSize": "1.2 x 0.6 x 0.4",
          "lesionDescription": [
            "Pigmented",
            "Papule"
          ],
          "lesionSize": "0.5",
          "deepInked": true,
          "blocks": "2",
          "lesionType": "Melanocytic naevus",
          "skSubtype": "Acanthotic",
          "pgUlceration": "Absent",
          "naevusType": "Compound",
          "congenitalPattern": false,
          "dysplasticFeatures": "None",
          "akGrade": "KIN I",
          "marginStatus": "Completely excised",
          "closestMargin": "2",
          "additionalNotes": ""
        }
      }
    ]
  }
}
