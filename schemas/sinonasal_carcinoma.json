   "reference": {
    "title": "WHO 5th sinonasal carcinoma classification & ancillary panel",
    "intro": "Poorly differentiated sinonasal carcinomas require systematic exclusion of molecularly defined entities (NUT, SWI/SNF complex-deficient, HPV-associated multiphenotypic, DEK::AFF2, EBV-positive lymphoepithelial carcinoma) before diagnosing SNUC.",
    "note": "Photomicrographs are from Wikimedia Commons under open Creative Commons licences. ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Squamous cell carcinoma & DEK::AFF2 carcinoma",
      "points": [
       "Keratinising SCC resembles conventional mucosal SCC and frequently arises in the maxillary sinus or in association with inverted sinonasal papilloma (EGFR exon 20).",
       "Non-keratinising SCC forms smooth-contoured ribbons and lobules of basaloid cells with minimal keratinisation; test p16 / high-risk HPV ISH (approx. 20–30% HPV-associated).",
       "DEK::AFF2 non-keratinising SCC shows deceptively bland exophytic/endophytic papillary ribbons with prominent neutrophilic infiltrate and strong nuclear AFF2 positivity (or DEK::AFF2 fusion)."
      ],
      "links": [
       {
        "label": "ExpertPath: Sinonasal Squamous Cell Carcinoma",
        "url": "https://app.expertpath.com/"
       }
      ]
     },
     {
      "heading": "Molecularly defined poorly differentiated entities & SNUC",
      "points": [
       "NUT carcinoma: monotonous poorly differentiated round cells with abrupt squamous differentiation; diffuse speckled nuclear NUT immunoreactivity (BRD4/BRD3/NSD3::NUTM1).",
       "SWI/SNF complex-deficient sinonasal carcinoma: basaloid or plasmacytoid/rhabdoid nests with complete nuclear loss of SMARCB1 (INI1) or SMARCA4 (BRG1).",
       "HPV-associated multiphenotypic sinonasal carcinoma (HMSC): adenoid cystic-like cribriform/solid basaloid growth with surface squamous dysplasia, diffuse p16, and high-risk HPV (most often type 33).",
       "SNUC is a diagnosis of exclusion: undifferentiated sheets with necrosis, keratin-positive, negative for p40/squamous differentiation, EBER, NUT, SMARCB1/SMARCA4 loss, and neuroendocrine markers (IDH2 R172 mutations common)."
      ],
      "links": [
       {
        "label": "ExpertPath: Sinonasal Undifferentiated Carcinoma & NUT Carcinoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/sinonasal_carcinoma/snuc.jpg",
        "caption": "Sinonasal undifferentiated carcinoma (SNUC, very high magnification): sheets of pleomorphic undifferentiated epithelial cells with prominent nucleoli and brisk mitotic activity (H&E).",
        "credit": "Nephron",
        "license": "CC BY-SA 3.0",
        "url": "https://commons.wikimedia.org/wiki/File%3ASinonasal_undifferentiated_carcinoma_-_very_high_mag.jpg"
       }
      ]
     },
     {
      "heading": "Sinonasal adenocarcinomas",
      "points": [
       "Intestinal-type adenocarcinoma (ITAC): papillary, colonic, solid, mucinous or mixed patterns expressing CDX2, CK20, SATB2 and MUC2; associated with hardwood/leather dust exposure.",
       "Non-intestinal-type adenocarcinoma: low-grade (tubulopapillary, bland, seromucinous phenotype, S100/SOX10/DOG1 variable) vs high-grade (solid/glandular, pleomorphic, necrosis)."
      ],
      "links": [
       {
        "label": "ExpertPath: Sinonasal Intestinal-Type Adenocarcinoma",
        "url": "https://app.expertpath.com/"
       }
      ]
     }
    ]
   }
