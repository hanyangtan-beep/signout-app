  "partDefaults": [
    {
      "clinicalLabel": "lipoma",
      "procedure": "Excision"
    }
  ],
  "fields": [
    {
      "id": "specimenName",
      "label": "Specimen as received (blank = built from site, label and procedure)",
      "type": "text",
      "placeholder": "Right thigh lipoma, excision",
      "default": ""
    },
    {
      "id": "organ",
      "label": "Organ (diagnosis line)",
      "type": "select",
      "options": [
        "SOFT TISSUE",
        "SKIN",
        "SKIN AND SUBCUTIS"
      ],
      "default": "SOFT TISSUE"
    },
    {
      "id": "site",
      "label": "Site / laterality",
      "type": "text",
      "placeholder": "right thigh",
      "default": ""
    },
    {
      "id": "clinicalLabel",
      "label": "Clinical label",
      "type": "text",
      "placeholder": "lipoma / skin nodule / mass",
      "default": "lipoma"
    },
    {
      "id": "procedure",
      "label": "Procedure",
      "type": "select",
      "options": [
        "Excision",
        "Resection",
        "Biopsy"
      ],
      "default": "Excision"
    },
    {
      "id": "dimensions",
      "label": "Dimensions (cm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "6 x 4 x 2.5",
      "default": ""
    },
    {
      "id": "weight",
      "label": "Weight (g, optional)",
      "type": "number",
      "group": "Macroscopy",
      "min": 0,
      "step": 0.1,
      "suffix": "g",
      "placeholder": "30",
      "default": ""
    },
    {
      "id": "description",
      "label": "Description",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Lobulated yellow fatty tissue with a thin capsule",
        "Well-circumscribed firm tan-white nodule",
        "Cystic with gelatinous contents",
        "Ill-defined fibrofatty tissue"
      ],
      "default": "Lobulated yellow fatty tissue with a thin capsule"
    },
    {
      "id": "cutSurface",
      "label": "Cut surface",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Homogeneous yellow",
        "Whorled tan-white",
        "Myxoid",
        "Haemorrhagic",
        "Necrotic areas – describe"
      ],
      "default": "Homogeneous yellow"
    },
    {
      "id": "cutSurfaceOther",
      "label": "Cut surface description",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "yellow with a 1 cm area of necrosis",
      "default": "",
      "showIf": {
        "field": "cutSurface",
        "is": "Necrotic areas – describe"
      }
    },
    {
      "id": "capsule",
      "label": "Capsule",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Thin intact",
        "Partially encapsulated",
        "Not identified"
      ],
      "default": "Thin intact"
    },
    {
      "id": "blocks",
      "label": "Blocks",
      "type": "number",
      "group": "Macroscopy",
      "min": 1,
      "step": 1,
      "default": "3"
    },
    {
      "id": "diagnosis",
      "label": "Diagnosis",
      "type": "select",
      "options": [
        "Lipoma",
        "Angiolipoma",
        "Fibrolipoma",
        "Spindle cell lipoma",
        "Hibernoma",
        "Schwannoma",
        "Neurofibroma",
        "Ganglion cyst",
        "Nodular fasciitis",
        "Cavernous haemangioma",
        "Leiomyoma",
        "Intramuscular myxoma",
        "Fibroma",
        "Epidermal cyst",
        "Atypical lipomatous tumour – see comment",
        "Sarcoma – see comment"
      ],
      "default": "Lipoma"
    },
    {
      "id": "fatNecrosis",
      "label": "Fat necrosis",
      "type": "select",
      "options": [
        "Absent",
        "Present"
      ],
      "default": "Absent"
    },
    {
      "id": "atypicalCells",
      "label": "Atypical stromal cells or lipoblasts",
      "type": "select",
      "options": [
        "Absent",
        "Present – see comment"
      ],
      "default": "Absent"
    },
    {
      "id": "mitosesSentence",
      "label": "Add \"No increased mitotic activity or necrosis is seen.\"",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "encapsulation",
      "label": "Encapsulation",
      "type": "select",
      "options": [
        "Partially encapsulated",
        "Well circumscribed and encapsulated",
        "Unencapsulated, ill-defined"
      ],
      "default": "Partially encapsulated"
    },
    {
      "id": "margins",
      "label": "Margins",
      "type": "select",
      "options": [
        "Complete",
        "Incomplete – reaches inked margin",
        "Not assessable"
      ],
      "default": "Complete"
    },
    {
      "id": "ihc",
      "label": "Immunohistochemistry / ancillary (optional)",
      "type": "text",
      "placeholder": "S100 positive / MDM2 FISH recommended",
      "default": ""
    },
    {
      "id": "additionalNotes",
      "label": "Additional microscopy",
      "type": "textarea",
      "placeholder": "Free text appended to the microscopy for this part",
      "default": ""
    }
  ],
  "snippets": [
    {
      "id": "soft_tissue_mdm2_large_deep",
      "label": "Large / deep adipocytic tumour — consider MDM2 testing",
      "auto": {
        "flag": "largeDeepAdipocytic"
      },
      "text": "For a deep-seated or large (>10 cm) adipocytic tumour, MDM2 amplification testing may be considered to exclude atypical lipomatous tumour."
    },
    {
      "id": "soft_tissue_sarcoma_template",
      "label": "Atypical / malignant — MDM2 testing and QMH soft tissue sarcoma template",
      "auto": {
        "field": "diagnosis",
        "is": [
          "Atypical lipomatous tumour – see comment",
          "Sarcoma – see comment"
        ]
      },
      "text": "An atypical or malignant mesenchymal tumour is identified ({parts}). This benign template does not grade or stage the lesion. MDM2 amplification testing (FISH) is recommended for an atypical adipocytic tumour, and the QMH soft tissue sarcoma template should be used for the final synoptic report."
    },
    {
      "id": "soft_tissue_atypical_cells",
      "label": "Atypical stromal cells / lipoblasts — MDM2 testing recommended",
      "auto": {
        "field": "atypicalCells",
        "is": "Present – see comment"
      },
      "text": "Atypical stromal cells / lipoblasts are present ({parts}). MDM2 amplification testing (FISH) is recommended to exclude atypical lipomatous tumour; if confirmed, the QMH soft tissue sarcoma template should be used for the final report."
    }
  ],
