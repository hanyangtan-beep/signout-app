{
  "id": "salivary_benign",
  "version": "2026.09",
  "name": "Parotid / submandibular gland",
  "shortName": "Salivary · parotidectomy / excision",
  "label": "Salivary",
  "organ": "PAROTID",
  "system": "Head and neck",
  "kind": "benign resection",
  "rank": 42,
  "aliases": [
    "parotid",
    "submandibular",
    "salivary",
    "pleomorphic adenoma",
    "Warthin",
    "sialadenitis",
    "sialolithiasis",
    "parotidectomy",
    "oncocytoma",
    "basal cell adenoma",
    "mucocoele",
    "ranula",
    "Kuttner"
  ],
  "specimenNoun": "resection",
  "maxParts": 3,
  "defaultParts": 1,
  "generator": "salivary",
  "style": {
    "british": true
  },
  "caseFields": [],
  "options": [
    {
      "id": "includeHeader",
      "label": "Section headers (SPECIMEN / MICROSCOPIC EXAMINATION / DIAGNOSIS)",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "macro",
      "label": "Generate the macroscopic description and block key",
      "type": "checkbox",
      "default": true
    }
  ],
  "fields": [
    {
      "id": "specimenName",
      "label": "Specimen as labelled (optional override)",
      "type": "text",
      "placeholder": "Left parotid, superficial parotidectomy",
      "default": ""
    },
    {
      "id": "gland",
      "label": "Gland",
      "type": "select",
      "options": [
        "Parotid",
        "Submandibular gland",
        "Minor salivary gland, lip",
        "Minor salivary gland, palate"
      ],
      "default": "Parotid"
    },
    {
      "id": "laterality",
      "label": "Laterality",
      "type": "select",
      "options": [
        "Left",
        "Right",
        "Not stated"
      ],
      "default": "Left"
    },
    {
      "id": "procedure",
      "label": "Procedure",
      "type": "select",
      "options": [
        "Superficial parotidectomy",
        "Total parotidectomy",
        "Submandibular gland excision",
        "Excision of lesion",
        "Excision biopsy"
      ],
      "default": "Superficial parotidectomy"
    },
    {
      "id": "dimensions",
      "label": "Specimen size (cm)",
      "type": "text",
      "placeholder": "4.5 x 3.5 x 2",
      "default": "",
      "group": "Macroscopy"
    },
    {
      "id": "weight",
      "label": "Weight",
      "type": "number",
      "min": 0,
      "step": 0.1,
      "suffix": "g",
      "default": "",
      "group": "Macroscopy"
    },
    {
      "id": "noduleDescription",
      "label": "Nodule",
      "type": "select",
      "options": [
        "Well-circumscribed, glistening",
        "Cystic with brown fluid",
        "Firm, tan",
        "No discrete nodule"
      ],
      "default": "Well-circumscribed, glistening",
      "group": "Macroscopy"
    },
    {
      "id": "noduleSize",
      "label": "Nodule size (cm)",
      "type": "text",
      "placeholder": "2.5 or 2.5 x 2 x 1.8",
      "default": "",
      "group": "Macroscopy",
      "showIf": {
        "field": "noduleDescription",
        "not": "No discrete nodule"
      }
    },
    {
      "id": "grossCapsule",
      "label": "Capsule (gross)",
      "type": "select",
      "options": [
        "Intact",
        "Breached",
        "Satellite nodule"
      ],
      "default": "Intact",
      "group": "Macroscopy",
      "showIf": {
        "field": "noduleDescription",
        "not": "No discrete nodule"
      }
    },
    {
      "id": "marginDistance",
      "label": "Distance to closest inked margin",
      "type": "number",
      "min": 0,
      "step": 0.5,
      "suffix": "mm",
      "default": "",
      "group": "Macroscopy",
      "showIf": {
        "field": "noduleDescription",
        "not": "No discrete nodule"
      }
    },
    {
      "id": "grossBackground",
      "label": "Surrounding gland",
      "type": "select",
      "options": [
        "Unremarkable",
        "Firm, fibrotic",
        "Atrophic"
      ],
      "default": "Unremarkable",
      "group": "Macroscopy"
    },
    {
      "id": "stone",
      "label": "Calculus present",
      "type": "checkbox",
      "default": false,
      "group": "Macroscopy"
    },
    {
      "id": "stoneSize",
      "label": "Calculus size",
      "type": "text",
      "placeholder": "8 mm",
      "default": "",
      "group": "Macroscopy",
      "showIf": {
        "field": "stone",
        "truthy": true
      }
    },
    {
      "id": "blocks",
      "label": "Blocks",
      "type": "number",
      "min": 1,
      "step": 1,
      "default": "5",
      "group": "Macroscopy"
    },
    {
      "id": "lesion",
      "label": "Lesion",
      "type": "select",
      "options": [
        "Pleomorphic adenoma",
        "Warthin tumour",
        "Basal cell adenoma",
        "Oncocytoma",
        "Myoepithelioma",
        "Lymphoepithelial cyst",
        "Chronic sialadenitis",
        "Küttner tumour (chronic sclerosing sialadenitis)",
        "Intraparotid lymph node, reactive",
        "Mucocoele / ranula",
        "Malignant - see comment"
      ],
      "default": "Pleomorphic adenoma"
    },
    {
      "id": "stroma",
      "label": "Stroma",
      "type": "select",
      "options": [
        "Chondromyxoid",
        "Hyalinised"
      ],
      "default": "Chondromyxoid",
      "showIf": {
        "field": "lesion",
        "is": "Pleomorphic adenoma"
      }
    },
    {
      "id": "microCapsule",
      "label": "Capsule (microscopic)",
      "type": "select",
      "options": [
        "Intact",
        "Focally thin",
        "Breached"
      ],
      "default": "Intact",
      "showIf": {
        "field": "lesion",
        "is": "Pleomorphic adenoma"
      }
    },
    {
      "id": "satellites",
      "label": "Satellite nodules",
      "type": "checkbox",
      "default": false,
      "showIf": {
        "field": "lesion",
        "is": "Pleomorphic adenoma"
      }
    },
    {
      "id": "sialolithiasis",
      "label": "Sialolithiasis",
      "type": "checkbox",
      "default": false,
      "showIf": {
        "field": "lesion",
        "is": [
          "Chronic sialadenitis",
          "Küttner tumour (chronic sclerosing sialadenitis)"
        ]
      }
    },
    {
      "id": "igg4",
      "label": "IgG4-related pattern (storiform fibrosis, obliterative phlebitis, plasma cell-rich infiltrate)",
      "type": "checkbox",
      "default": false,
      "showIf": {
        "field": "lesion",
        "is": [
          "Chronic sialadenitis",
          "Küttner tumour (chronic sclerosing sialadenitis)"
        ]
      }
    },
    {
      "id": "whoType",
      "label": "WHO tumour type",
      "type": "text",
      "placeholder": "Mucoepidermoid carcinoma",
      "default": "",
      "showIf": {
        "field": "lesion",
        "is": "Malignant - see comment"
      }
    },
    {
      "id": "margin",
      "label": "Margin status",
      "type": "select",
      "options": [
        "Completely excised",
        "Tumour reaches inked margin",
        "Capsule breached at margin"
      ],
      "default": "Completely excised",
      "showIf": {
        "field": "lesion",
        "not": [
          "Chronic sialadenitis",
          "Küttner tumour (chronic sclerosing sialadenitis)",
          "Intraparotid lymph node, reactive"
        ]
      }
    },
    {
      "id": "lymphNodes",
      "label": "Lymph node(s) included",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "nodePositive",
      "label": "Nodes involved",
      "type": "number",
      "min": 0,
      "step": 1,
      "default": "0",
      "showIf": {
        "field": "lymphNodes",
        "truthy": true
      }
    },
    {
      "id": "nodeTotal",
      "label": "Nodes examined",
      "type": "number",
      "min": 1,
      "step": 1,
      "default": "1",
      "showIf": {
        "field": "lymphNodes",
        "truthy": true
      }
    },
    {
      "id": "facialNerve",
      "label": "Facial nerve branch included",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "additionalNotes",
      "label": "Additional microscopy",
      "type": "textarea",
      "placeholder": "Free text appended to the microscopy for this part",
      "default": ""
    }
  ],
