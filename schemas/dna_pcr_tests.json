  },
  {
   "id": "assayPanel",
   "label": "DNA PCR assay / target gene(s)",
   "group": "Pre-analytic & Assay",
   "type": "select",
   "default": "EGFR mutation PCR (exons 18–21)",
   "options": [
    "EGFR mutation PCR (exons 18–21)",
    "KRAS / NRAS mutation PCR (exons 2, 3, 4)",
    "BRAF V600 mutation PCR",
    "KIT / PDGFRA mutation PCR",
    "IDH1 / IDH2 mutation PCR",
    "TERT promoter mutation PCR (C228T / C250T)",
    "MGMT promoter methylation-specific PCR",
    "MSI PCR (pentaplex mononucleotide panel)",
    "B-cell / T-cell clonality PCR (BIOMED-2)",
    "Other DNA PCR assay (specify in notes)"
   ],
   "reference": {
    "title": "Real-time DNA PCR amplification & melting-curve quality control",
    "intro": "Confirm adequate tumour cellularity above the assay limit of detection (typically >= 5–10% for real-time allele-specific PCR; >= 20% for Sanger sequencing) and inspect internal control Ct and melt peaks before calling a negative result.",
    "note": "Reference figures are from Wikimedia Commons under open Creative Commons licences. ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Amplification curves & melt-peak specificity",
      "points": [
       "A valid positive call shows a clean sigmoidal amplification curve crossing the threshold within the validated Ct window with an intact endogenous internal control.",
       "Non-responsive flat baselines with failed internal control indicate DNA degradation, decalcification artefact, or PCR inhibition — report as indeterminate rather than wild-type.",
       "Derivative melting-curve analysis confirms a single specific amplicon peak and excludes primer-dimer artefacts."
      ],
      "links": [
       {
        "label": "ExpertPath: Molecular Testing (PCR & Mutation Assays)",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/dna_pcr_tests/qpcr_curves.jpg",
        "caption": "Real-time PCR amplification curves illustrating responsive target amplification, non-responsive baseline, and ambiguous traces requiring repeat or orthogonal review.",
        "credit": "Tzachi Bar",
        "license": "CC BY-SA 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Responsive,_non-responsive_and_ambiguous_real-time_PCR_curves..png"
       },
       {
        "src": "assets/reference/dna_pcr_tests/qpcr_melting.jpg",
        "caption": "Real-time PCR derivative melting-curve plot showing sharp, single-peak amplicon specificity across replicates.",
        "credit": "Zuzanna K. Filutowska",
        "license": "CC BY-SA 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Qpcr-melting.png"
       }
      ]
     }
    ]
   }
  },
  {
   "id": "platform",
   "label": "Platform / method",
   "group": "Pre-analytic & Assay",
   "type": "select",
   "default": "Real-time allele-specific PCR (cobas / Idylla / LDT)",
   "options": [
