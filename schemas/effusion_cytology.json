{
  "id": "effusion_cytology",
  "version": 1,
  "name": "Effusion cytology (International System)",
  "shortName": "Serous fluid · cytology",
  "label": "Effusion",
  "organ": "Serous fluid",
  "system": "Cytology",
  "kind": "cytology",
  "rank": 640,
  "aliases": [
    "pleural fluid",
    "ascitic fluid",
    "peritoneal fluid",
    "pericardial fluid",
    "washing",
    "effusion",
