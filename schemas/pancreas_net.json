   "reference": {
    "title": "AJCC 9th staging of pancreatic neuroendocrine tumours (pT1\u2013pT4, pM1a\u2013c)",
    "intro": "Unlike exocrine PDAC, peripancreatic soft tissue extension alone does NOT upstage a PanNET to pT3 \u2014 size cutoffs (<2 cm, 2\u20134 cm, >4 cm) govern pT1\u2013pT3 unless duodenum, ampulla, CBD (pT3), adjacent organs, or large vessel walls (pT4) are invaded.",
    "note": "ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Key AJCC 9th pT and pM rules",
      "points": [
       "pT1: < 2 cm, limited to pancreas; pT2: 2\u20134 cm, limited to pancreas; pT3: > 4 cm OR invades duodenum / ampulla / common bile duct; pT4: invades stomach, spleen, colon, adrenal gland, or wall of large vessels.",
       "pM1a: liver only; pM1b: extrahepatic site(s) only; pM1c: both hepatic and extrahepatic sites."
      ],
      "links": [
       {
        "label": "ExpertPath: Staging of Pancreatic Neuroendocrine Tumours",
        "url": "https://app.expertpath.com/"
       }
      ]
     }
