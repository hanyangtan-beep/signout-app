    "GX: Grade cannot be assessed",
    "Not applicable"
   ],
   "reference": {
    "title": "WHO 5th grading of pancreatic neuroendocrine tumours (PanNET G1\u2013G3 vs PanNEC)",
    "intro": "Assign the higher grade whenever mitotic rate and Ki-67 labelling index fall into different tiers. Count mitoses in 10 mm2 (42 HPF with 22 mm eyepiece / x40 objective) and divide by 5 for mitoses per 2 mm2; count >= 500 tumour cells in the Ki-67 hot spot.",
    "note": "ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "WHO 5th Grade Cutoffs (PanNET)",
      "points": [
       "G1: < 2 mitoses / 2 mm2 AND Ki-67 < 3%.",
       "G2: 2\u201320 mitoses / 2 mm2 OR Ki-67 3\u201320%.",
       "G3: > 20 mitoses / 2 mm2 OR Ki-67 > 20% (retains well-differentiated organoid architecture, uniform chromatin, DAXX/ATRX loss, preserved Rb and wild-type p53)."
      ],
      "links": [
       {
        "label": "ExpertPath: Pancreatic Neuroendocrine Tumour",
        "url": "https://app.expertpath.com/"
       }
      ]
     },
     {
      "heading": "PanNET G3 vs poorly differentiated PanNEC",
      "points": [
       "PanNEC (small cell or large cell) shows marked pleomorphism, diffuse sheets, geographic necrosis, Ki-67 typically > 55%, abnormal p53, Rb loss, and retained DAXX/ATRX \u2014 report PanNEC using the exocrine pancreas carcinoma protocol rather than the PanNET protocol."
      ],
      "links": [
       {
        "label": "ExpertPath: Pancreatic Neuroendocrine Carcinoma",
        "url": "https://app.expertpath.com/"
       }
      ]
     }
    ]
   }
