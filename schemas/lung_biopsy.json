  "snippets": [
    {
      "id": "lung_granuloma",
      "label": "Granuloma — culture correlation",
      "auto": {
        "field": "granuloma",
        "is": [
          "Necrotising granulomas",
          "Non-necrotising granulomas"
        ]
      },
      "text": "Granulomatous inflammation is present in {parts}. The differential includes mycobacterial and fungal infection and sarcoidosis; correlation with microbiological culture and the clinical and radiological findings is recommended."
    },
    {
      "id": "lung_small_biopsy",
      "label": "Small biopsy caveat (adenocarcinoma)",
      "auto": {
        "field": "adenoPattern",
        "is": "Lepidic"
      },
      "text": "In situ (lepidic) and invasive components cannot be reliably distinguished on a small biopsy; the predominant pattern is provisional and definitive subtyping requires the resection specimen."
    },
    {
      "id": "lung_nsclc_nos",
      "label": "NSCC NOS — limited tissue",
      "auto": {
        "field": "neoplasia",
        "is": "Non-small cell carcinoma, not further classifiable"
      },
      "text": "The tumour cannot be further classified on morphology and immunohistochemistry in the limited material available. Correlation with cytology or repeat sampling is suggested if subtyping will alter management."
    }
  ],
