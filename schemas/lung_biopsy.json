{
  "id": "lung_biopsy",
  "version": "2026.09",
  "name": "Lung / bronchial biopsy",
  "shortName": "Lung · biopsy",
  "label": "Lung",
  "organ": "LUNG",
  "system": "Thoracic",
  "kind": "biopsy",
  "rank": 10,
  "aliases": [
    "bronchial",
    "transbronchial",
    "EBUS",
    "cryobiopsy",
    "TTF-1",
    "p40",
    "PD-L1",
    "granuloma"
  ],
  "match": {
    "site": [
      "lung",
      "bronchus",
      "bronchial",
      "transbronchial",
      "EBUS",
      "lobe"
    ],
    "procedure": [
      "biopsy",
      "biopsies",
      "cryobiopsy",
      "transbronchial",
      "endobronchial",
      "CT-guided",
      "core"
    ],
    "clinical": [
      "lung mass",
      "lung nodule",
      "lung ca",
      "lung cancer",
      "opacity",
      "consolidation",
      "bronchoscopy",
      "granuloma",
      "TB",
      "tuberculosis"
    ]
  },
  "specimenNoun": "biopsy",
  "maxParts": 6,
  "defaultParts": 1,
  "generator": "lung",
  "style": {
    "british": true
  },
  "caseFields": [
    {
      "id": "imaging",
      "label": "Imaging / clinical",
      "placeholder": "RUL mass 3 cm; mediastinal nodes",
      "help": "Optional; not printed."
    }
  ],
  "options": [
    {
      "id": "includeHeader",
      "label": "Section headers (SPECIMEN / MICROSCOPIC EXAMINATION / DIAGNOSIS)",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "summary",
      "label": "Case summary line after the diagnosis (tumour type, nodes, ancillary tests)",
      "type": "checkbox",
      "default": true
    },
    {
      "id": "molecularLine",
      "label": "Print the PD-L1 / molecular testing lines under the diagnosis",
      "type": "checkbox",
      "default": true
    }
  ],
  "partDefaults": [
    {
      "specimenType": "Transbronchial biopsy",
      "site": ""
    },
    {
      "specimenType": "Endobronchial biopsy",
      "site": ""
    },
    {
      "specimenType": "EBUS lymph node core biopsy",
      "site": "station 7"
    }
  ],
  "fields": [
    {
      "id": "specimenType",
      "label": "Specimen",
      "type": "select",
      "options": [
        "Transbronchial biopsy",
        "Endobronchial biopsy",
        "Transbronchial cryobiopsy",
        "CT-guided core biopsy",
        "EBUS-guided core biopsy (mass)",
        "EBUS lymph node core biopsy"
      ],
      "default": "Transbronchial biopsy"
    },
    {
      "id": "site",
      "label": "Site",
      "type": "text",
      "placeholder": "right upper lobe",
      "default": "",
      "help": "Lobe / segment, or nodal station for EBUS nodes."
    },
    {
      "id": "pieces",
      "label": "Number of pieces / cores",
      "type": "number",
      "placeholder": "3",
      "default": ""
    },
    {
      "id": "tissue",
      "label": "Tissue present",
      "type": "select",
      "options": [
        "Bronchial mucosa",
        "Bronchial mucosa and alveolated lung parenchyma",
        "Alveolated lung parenchyma",
        "Fibrous tissue and tumour",
        "Blood, fibrin and crushed cells only (inadequate)"
      ],
      "default": "Bronchial mucosa",
      "showIf": {
        "field": "specimenType",
        "not": "EBUS lymph node core biopsy"
      }
    },
    {
      "id": "nodeTissue",
      "label": "Node tissue",
      "type": "select",
      "options": [
        "Lymphoid tissue",
        "Lymphoid tissue and bronchial mucosa",
        "Blood and scant lymphocytes only (inadequate)"
      ],
      "default": "Lymphoid tissue",
      "showIf": {
        "field": "specimenType",
        "is": "EBUS lymph node core biopsy"
      }
    },
    {
      "id": "nodeFinding",
      "label": "Node finding",
      "type": "select",
      "options": [
        "Negative for malignancy",
        "Metastatic carcinoma",
        "Granulomas",
        "Anthracosis and reactive change",
        "Atypical lymphoid infiltrate"
      ],
      "default": "Negative for malignancy",
      "showIf": {
        "field": "specimenType",
        "is": "EBUS lymph node core biopsy"
      }
    },
    {
      "id": "benign",
      "label": "Benign / inflammatory",
      "type": "select",
      "options": [
        "None",
        "Chronic bronchitis with goblet cell hyperplasia",
        "Squamous metaplasia",
        "Organising pneumonia",
        "Acute lung injury with hyaline membranes",
        "Eosinophilic infiltrate",
        "Aspiration (foreign material with giant cell reaction)",
        "Anthracosis",
        "Interstitial fibrosis",
        "Viral cytopathic change"
      ],
      "default": "None",
      "showIf": {
        "field": "specimenType",
        "not": "EBUS lymph node core biopsy"
      }
    },
    {
      "id": "squamousDysplasia",
      "label": "Squamous dysplasia",
      "type": "select",
      "options": [
        "Absent",
        "Low grade",
        "High grade / carcinoma in situ"
      ],
      "default": "Absent",
      "showIf": {
        "field": "benign",
        "is": "Squamous metaplasia"
      }
    },
    {
      "id": "granuloma",
      "label": "Granulomas",
      "type": "select",
      "options": [
        "Absent",
        "Non-necrotising granulomas",
        "Necrotising granulomas"
      ],
      "default": "Absent"
    },
    {
      "id": "specialStains",
      "label": "Special stains (ZN / PASD / GMS)",
      "type": "select",
      "options": [
        "Not performed",
        "Negative for acid-fast bacilli and fungal elements",
        "Acid-fast bacilli present",
        "Fungal elements present"
      ],
      "default": "Not performed",
      "showIf": {
        "field": "granuloma",
        "not": "Absent"
      }
    },
    {
      "id": "organisms",
      "label": "Organisms",
      "type": "select",
      "options": [
        "None",
        "Aspergillus-type septate hyphae",
        "Pneumocystis",
        "Cryptococcus",
        "Mucorales-type hyphae",
        "Other (specify in notes)"
      ],
      "default": "None"
    },
    {
      "id": "neoplasia",
      "label": "Neoplasia",
      "type": "select",
      "options": [
        "None",
        "Adenocarcinoma",
        "Squamous cell carcinoma",
        "Non-small cell carcinoma, favour adenocarcinoma",
        "Non-small cell carcinoma, favour squamous cell carcinoma",
        "Non-small cell carcinoma, not further classifiable",
        "Small cell carcinoma",
        "Large cell neuroendocrine carcinoma",
        "Carcinoid / neuroendocrine tumour",
        "Metastatic carcinoma",
        "Atypical cells suspicious for carcinoma",
        "Atypical lymphoid infiltrate (lymphoma suspected)"
      ],
      "default": "None"
    },
    {
      "id": "adenoPattern",
      "label": "Adenocarcinoma pattern(s)",
      "type": "multiselect",
      "options": [
        "Lepidic",
        "Acinar",
        "Papillary",
        "Micropapillary",
        "Solid",
        "Invasive mucinous"
      ],
      "exclusive": [
        "Invasive mucinous"
      ],
      "default": [],
      "help": "Tick every pattern present; invasive mucinous adenocarcinoma is a distinct entity and clears the others.",
      "showIf": {
        "field": "neoplasia",
        "is": "Adenocarcinoma"
      }
    },
    {
      "id": "adenoPredominant",
      "label": "Predominant pattern",
      "type": "select",
      "options": [
        "Not specified",
        "Lepidic",
        "Acinar",
        "Papillary",
        "Micropapillary",
        "Solid"
      ],
      "default": "Not specified",
      "showIf": {
        "field": "adenoPattern",
        "min": 2
      }
    },
    {
      "id": "sccType",
      "label": "SCC type",
      "type": "select",
      "options": [
        "Non-keratinising",
        "Keratinising",
        "Basaloid"
      ],
      "default": "Non-keratinising",
      "showIf": {
        "field": "neoplasia",
        "is": "Squamous cell carcinoma"
      }
    },
    {
      "id": "carcinoidType",
      "label": "Neuroendocrine tumour type",
      "type": "select",
      "options": [
        "Typical carcinoid",
        "Atypical carcinoid",
        "Not further classifiable on biopsy"
      ],
      "default": "Typical carcinoid",
      "showIf": {
        "field": "neoplasia",
        "is": "Carcinoid / neuroendocrine tumour"
      }
    },
    {
      "id": "metastasisPrimary",
      "label": "Favoured primary",
      "type": "text",
      "placeholder": "colorectal",
      "default": "",
      "showIf": {
        "field": "neoplasia",
        "is": "Metastatic carcinoma"
      }
    },
    {
      "id": "ttf1",
