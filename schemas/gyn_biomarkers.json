  {
   "id": "p53Status",
   "label": "p53 immunohistochemistry",
   "group": "Molecular & IHC Panel",
   "type": "select",
   "default": "Wild-type (variable patchy nuclear staining)",
   "options": [
    "Wild-type (variable patchy nuclear staining)",
    "Abnormal / mutant-type: diffuse strong nuclear overexpression (> 80%)",
    "Abnormal / mutant-type: complete absence (null) with intact internal control",
    "Abnormal / mutant-type: diffuse cytoplasmic staining",
    "Subclonal abnormal / mutant-type",
    "Not performed"
   ],
   "reference": {
    "title": "WHO 5th gynaecological biomarker scoring (p53, MMR, HER2, ER/PR, POLE)",
    "intro": "For endometrial carcinoma, integrate POLE mutation, MMR IHC, and p53 IHC to assign the TCGA/ProMisE molecular subtype (POLEmut, MMRd, NSMP, or p53abn). Use endometrial serous HER2 criteria (complete/basolateral 3+ in > 30% tumour cells).",
    "note": "Photomicrographs are from Wikimedia Commons under open Creative Commons licences. ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Scoring thresholds & p53 / ER IHC patterns",
      "points": [
       "p53 abnormal patterns: diffuse strong nuclear overexpression (> 80%), complete absence (null) with positive internal control, or unequivocal cytoplasmic staining.",
       "HER2 (endometrial serous): 3+ = strong complete or basolateral/lateral membranous staining in > 30% of tumour cells; 2+ = equivocal (reflex ISH)."
      ],
      "links": [
       {
        "label": "ExpertPath: Endometrial Carcinoma Molecular Classification",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/gyn_biomarkers/p53_patterns.jpg",
        "caption": "Four-pattern p53 IHC reference in endometrial carcinoma: (A) wild-type heterogeneous nuclear, (B) abnormal diffuse strong nuclear overexpression, (C) abnormal complete absence (null) with intact stromal internal control, and (D) abnormal cytoplasmic staining.",
        "credit": "Köbel M, Ronnett BM, Singh N, Soslow RA, Gilks CB, McCluggage WG",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Patterns_of_p53_expression,_original.png"
       },
       {
        "src": "assets/reference/gyn_biomarkers/er_ihc_positive.jpg",
        "caption": "Strong diffuse nuclear oestrogen receptor (ER) immunohistochemistry positivity.",
        "credit": "Ed Uthman",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Stomach_Metastatic_Breast_Carcinoma,_IHC_for_Estrogen_Receptor_(5610737866).jpg"
       }
      ]
     }
    ]
   }
  },
