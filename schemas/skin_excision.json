    "fill": [
      {
        "field": "specimenName",
        "from": "detail"
      }
    ]
  },
  "macroExtract": {
    "ellipseSize": {
      "concept": "specimenDims",
      "unit": "cm"
    },
    "lesionSize": {
      "concept": "tumourDims",
      "unit": "cm",
      "min": 1
    },
    "blocks": {
      "concept": "blocks",
      "unit": "count"
    },
    "blockScheme": {
      "concept": "choice",
      "map": [
        [
          "(?:serially\\s+(?:sliced|sectioned)|bisected)[^.]*all\\s+embedded|all\\s+embedded[^.]*serially",
          "Ellipse serially sliced and all embedded"
        ],
        [
          "representative\\s+(?:sections?|blocks?)|partially\\s+embedded",
          "Representative sections"
        ]
      ]
    }
  },
  "specimenNoun": "excision",
  "maxParts": 3,
  "defaultParts": 1,
  "generator": "skinexcision",
  "style": {
    "british": true
  },
  "caseFields": [],
  "options": [
    {
      "$use": "includeHeader"
    },
    {
      "id": "macro",
      "label": "Generate the macroscopic description and block key",
      "type": "checkbox",
      "default": true
    }
  ],
  "partDefaults": [],
  "fields": [
    {
      "id": "specimenName",
      "label": "Site",
      "type": "text",
      "placeholder": "left cheek",
      "default": ""
    },
    {
      "id": "clinicalLabel",
      "label": "Lesion (clinical label)",
      "type": "text",
      "placeholder": "nodule",
      "default": "nodule"
    },
    {
      "id": "ellipseSize",
      "label": "Ellipse of skin (cm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "2.5 x 1.2 x 0.6",
      "default": ""
    },
    {
      "id": "lesionSize",
      "label": "Lesion size (cm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "0.8",
      "default": ""
    },
    {
      "id": "lesionAppearance",
      "label": "Lesion appearance",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Nodule",
        "Ulcerated nodule",
        "Ulcer",
        "Pigmented lesion",
        "Plaque",
        "Papule"
      ],
      "default": "Nodule"
    },
    {
      "id": "orientation",
      "label": "Orientation",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "None",
        "Suture at 12 o'clock = superior",
        "Other – describe"
      ],
      "default": "None"
    },
    {
      "id": "orientationOther",
      "label": "Orientation as received",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "long suture lateral, short suture superior",
      "default": "",
      "showIf": {
        "field": "orientation",
        "is": "Other – describe"
      }
    },
    {
      "id": "macroMargin",
      "label": "Closest macroscopic margin (mm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "2",
      "default": ""
    },
    {
      "id": "inking",
      "label": "Inking",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Deep surface inked",
        "Margins inked (see block key)",
        "Not inked"
      ],
      "default": "Deep surface inked"
    },
    {
      "id": "blocks",
      "label": "Blocks",
      "type": "number",
      "group": "Macroscopy",
      "min": 1,
      "step": 1,
      "default": "3"
    },
    {
      "id": "blockScheme",
      "label": "Sampling",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Ellipse serially sliced and all embedded",
        "Representative sections"
      ],
      "default": "Ellipse serially sliced and all embedded"
    },
    {
      "id": "diagnosis",
      "label": "Diagnosis",
      "type": "select",
      "options": [
        "Nodular basal cell carcinoma",
        "Superficial BCC",
        "Infiltrative BCC",
        "Micronodular BCC",
        "Keratoacanthoma",
        "Seborrhoeic keratosis",
        "Intradermal naevus",
        "Compound naevus",
        "Dermatofibroma",
        "Pyogenic granuloma",
        "Actinic keratosis",
        "Squamous cell carcinoma in situ (Bowen disease)",
        "Invasive SCC – see comment",
        "Melanoma – see comment",
        "Verruca vulgaris",
        "Pilomatrixoma",
        "Trichoepithelioma",
        "Trichoblastoma",
        "Trichilemmoma",
        "Trichofolliculoma",
        "Poroma",
        "Hidradenoma",
        "Spiradenoma",
        "Cylindroma",
        "Syringoma",
        "Syringocystadenoma papilliferum",
        "Mixed tumour (chondroid syringoma)",
        "Sebaceous hyperplasia",
        "Sebaceous adenoma",
        "Sebaceoma",
        "Naevus sebaceus",
        "Neurofibroma",
        "Schwannoma",
        "Granular cell tumour",
        "Fibroepithelial polyp",
        "Scar",
        "Keloid",
        "Haemangioma",
        "Lipoma",
        "Benign adnexal tumour, other",
        "Benign, other"
      ],
      "optionGroups": [
        {
          "label": "Basal cell carcinoma",
          "options": [
            "Nodular basal cell carcinoma",
            "Superficial BCC",
            "Infiltrative BCC",
            "Micronodular BCC"
          ]
        },
        {
          "label": "Keratinocytic",
          "options": [
            "Keratoacanthoma",
            "Seborrhoeic keratosis",
            "Verruca vulgaris",
            "Actinic keratosis",
            "Squamous cell carcinoma in situ (Bowen disease)",
            "Invasive SCC – see comment"
          ]
        },
        {
          "label": "Melanocytic",
          "options": [
            "Intradermal naevus",
            "Compound naevus",
            "Melanoma – see comment"
          ]
        },
        {
          "label": "Adnexal, follicular",
          "options": [
            "Pilomatrixoma",
            "Trichoepithelioma",
            "Trichoblastoma",
            "Trichilemmoma",
            "Trichofolliculoma"
          ]
        },
        {
          "label": "Adnexal, sweat gland",
          "options": [
            "Poroma",
            "Hidradenoma",
            "Spiradenoma",
            "Cylindroma",
            "Syringoma",
            "Syringocystadenoma papilliferum",
            "Mixed tumour (chondroid syringoma)"
          ]
        },
        {
          "label": "Adnexal, sebaceous",
          "options": [
            "Sebaceous hyperplasia",
            "Sebaceous adenoma",
            "Sebaceoma",
            "Naevus sebaceus"
          ]
        },
        {
          "label": "Neural",
          "options": [
            "Neurofibroma",
            "Schwannoma",
            "Granular cell tumour"
          ]
        },
        {
          "label": "Fibrous, vascular and fatty",
          "options": [
            "Dermatofibroma",
            "Fibroepithelial polyp",
            "Scar",
            "Keloid",
            "Pyogenic granuloma",
            "Haemangioma",
            "Lipoma"
          ]
        }
      ],
      "default": "Nodular basal cell carcinoma"
    },
    {
      "id": "keratotic",
      "label": "Keratotic variant (BCC)",
      "type": "checkbox",
      "default": false,
      "showIf": {
        "field": "diagnosis",
        "is": [
          "Nodular basal cell carcinoma",
          "Superficial BCC",
          "Infiltrative BCC",
          "Micronodular BCC"
        ]
      }
    },
    {
      "id": "pni",
      "label": "Perineural invasion",
      "type": "select",
      "options": [
        "Absent",
        "Present"
      ],
      "default": "Absent"
    },
    {
      "id": "ulceration",
      "label": "Ulceration",
      "type": "select",
      "options": [
        "Absent",
        "Present"
      ],
      "default": "Absent"
    },
    {
      "id": "marginSuperior",
      "label": "Superior margin (mm)",
      "type": "text",
      "placeholder": "1.5",
      "default": ""
    },
    {
      "id": "marginInferior",
      "label": "Inferior margin (mm)",
      "type": "text",
      "placeholder": "2.5",
      "default": ""
    },
    {
      "id": "marginLateral",
      "label": "Lateral margin (mm)",
      "type": "text",
      "placeholder": "3.5",
      "default": ""
    },
    {
      "id": "marginMedial",
      "label": "Medial margin (mm)",
      "type": "text",
      "placeholder": "6",
      "default": ""
    },
    {
      "id": "marginDeep",
      "label": "Deep margin (mm)",
      "type": "text",
      "placeholder": "2.5",
      "default": ""
    },
    {
      "id": "completeness",
      "label": "Excision",
      "type": "select",
      "options": [
        "Complete",
        "Involved – which",
        "Close < 1 mm"
      ],
      "default": "Complete"
    },
    {
      "id": "involvedMargins",
      "label": "Involved margin(s)",
      "type": "multiselect",
      "options": [
        "Superior",
        "Inferior",
        "Lateral",
        "Medial",
        "Deep"
      ],
      "default": [],
      "showIf": {
        "field": "completeness",
        "is": "Involved – which"
      }
    },
    {
      "id": "additionalNotes",
      "label": "Additional microscopy",
      "type": "textarea",
      "placeholder": "Free text appended to the microscopy for this part",
      "default": ""
    }
  ],
  "snippets": [
    {
      "id": "skin_cancer_template",
      "label": "Invasive SCC / melanoma — use the QMH skin cancer template",
      "auto": {
        "field": "diagnosis",
        "is": [
          "Invasive SCC – see comment",
          "Melanoma – see comment"
        ]
      },
      "text": "An invasive skin cancer is identified ({parts}). This benign template does not stage the lesion; the QMH skin cancer template should be used for the final synoptic report."
    }
  ],
