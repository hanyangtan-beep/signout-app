{
  "id": "skin_excision",
  "version": "2026.09",
  "name": "Skin lesion excision",
  "shortName": "Skin · excision with margins",
  "label": "Skin excision",
  "organ": "SKIN",
  "system": "Skin",
  "kind": "benign resection",
  "rank": 30,
  "aliases": [
    "BCC",
    "basal cell carcinoma",
    "keratoacanthoma",
    "seborrhoeic keratosis",
    "seborrheic keratosis",
    "naevus",
    "nevus",
    "dermatofibroma",
    "pyogenic granuloma",
    "actinic keratosis",
    "SCC in situ",
    "Bowen",
    "margins",
    "ellipse",
    "orientation suture"
  ],
  "match": {
    "site": [
      "skin",
      "scalp",
      "face",
      "eyelid",
      "ear",
      "lip",
      "nose"
    ],
    "procedure": [
      "excision",
      "excision biopsy",
      "wide excision",
      "re-excision",
      "ellipse"
    ],
    "clinical": [
      "BCC",
      "basal cell",
      "SCC",
      "squamous cell",
      "keratoacanthoma",
      "naevus",
      "nevus",
      "melanoma",
      "dermatofibroma",
      "seborrhoeic",
      "seborrheic",
      "actinic",
      "Bowen",
      "skin lesion",
      "skin tumour",
      "skin tumor",
      "pigmented"
    ],
    "fill": [
      {
        "field": "specimenName",
        "from": "detail"
      }
    ]
  },
  "specimenNoun": "excision",
  "maxParts": 3,
  "defaultParts": 1,
  "generator": "skinexcision",
  "style": {
    "british": true
  },
  "caseFields": [],
  "options": [
    {
      "id": "includeHeader",
      "label": "Section headers (SPECIMEN / MICROSCOPIC EXAMINATION / DIAGNOSIS)",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "macro",
      "label": "Generate the macroscopic description and block key",
      "type": "checkbox",
      "default": true
    }
  ],
  "partDefaults": [],
  "fields": [
    {
      "id": "specimenName",
      "label": "Site",
      "type": "text",
      "placeholder": "left cheek",
      "default": ""
    },
    {
      "id": "clinicalLabel",
      "label": "Lesion (clinical label)",
      "type": "text",
      "placeholder": "nodule",
      "default": "nodule"
    },
    {
      "id": "ellipseSize",
      "label": "Ellipse of skin (cm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "2.5 x 1.2 x 0.6",
      "default": ""
    },
    {
      "id": "lesionSize",
      "label": "Lesion size (cm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "0.8",
      "default": ""
    },
    {
      "id": "lesionAppearance",
      "label": "Lesion appearance",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Nodule",
        "Ulcerated nodule",
        "Ulcer",
        "Pigmented lesion",
        "Plaque",
        "Papule"
      ],
      "default": "Nodule"
    },
    {
      "id": "orientation",
      "label": "Orientation",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "None",
        "Suture at 12 o'clock = superior",
        "Other – describe"
      ],
      "default": "None"
    },
    {
      "id": "orientationOther",
      "label": "Orientation as received",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "long suture lateral, short suture superior",
      "default": "",
      "showIf": {
        "field": "orientation",
        "is": "Other – describe"
      }
    },
    {
      "id": "macroMargin",
      "label": "Closest macroscopic margin (mm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "2",
      "default": ""
    },
    {
      "id": "inking",
      "label": "Inking",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Deep surface inked",
        "Margins inked (see block key)",
        "Not inked"
      ],
      "default": "Deep surface inked"
    },
    {
      "id": "blocks",
      "label": "Blocks",
      "type": "number",
      "group": "Macroscopy",
      "min": 1,
      "step": 1,
      "default": "3"
    },
    {
      "id": "blockScheme",
      "label": "Sampling",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Ellipse serially sliced and all embedded",
        "Representative sections"
      ],
      "default": "Ellipse serially sliced and all embedded"
    },
    {
      "id": "diagnosis",
      "label": "Diagnosis",
      "type": "select",
      "options": [
        "Nodular basal cell carcinoma",
        "Superficial BCC",
        "Infiltrative BCC",
        "Micronodular BCC",
        "Keratoacanthoma",
        "Seborrhoeic keratosis",
        "Intradermal naevus",
        "Compound naevus",
        "Dermatofibroma",
        "Pyogenic granuloma",
        "Actinic keratosis",
        "Squamous cell carcinoma in situ (Bowen disease)",
        "Invasive SCC – see comment",
        "Melanoma – see comment",
        "Benign, other"
      ],
      "default": "Nodular basal cell carcinoma"
    },
    {
      "id": "keratotic",
      "label": "Keratotic variant (BCC)",
      "type": "checkbox",
      "default": false,
      "showIf": {
        "field": "diagnosis",
        "is": [
          "Nodular basal cell carcinoma",
          "Superficial BCC",
          "Infiltrative BCC",
          "Micronodular BCC"
        ]
      }
    },
    {
      "id": "pni",
      "label": "Perineural invasion",
      "type": "select",
      "options": [
        "Absent",
        "Present"
      ],
      "default": "Absent"
    },
    {
      "id": "ulceration",
      "label": "Ulceration",
      "type": "select",
      "options": [
        "Absent",
        "Present"
      ],
      "default": "Absent"
    },
    {
      "id": "marginSuperior",
      "label": "Superior margin (mm)",
      "type": "text",
      "placeholder": "1.5",
      "default": ""
    },
    {
      "id": "marginInferior",
      "label": "Inferior margin (mm)",
      "type": "text",
      "placeholder": "2.5",
      "default": ""
    },
    {
      "id": "marginLateral",
      "label": "Lateral margin (mm)",
      "type": "text",
      "placeholder": "3.5",
      "default": ""
    },
    {
      "id": "marginMedial",
      "label": "Medial margin (mm)",
      "type": "text",
      "placeholder": "6",
      "default": ""
    },
    {
      "id": "marginDeep",
      "label": "Deep margin (mm)",
      "type": "text",
      "placeholder": "2.5",
      "default": ""
    },
    {
      "id": "completeness",
      "label": "Excision",
      "type": "select",
      "options": [
        "Complete",
        "Involved – which",
        "Close < 1 mm"
      ],
      "default": "Complete"
    },
    {
      "id": "involvedMargins",
      "label": "Involved margin(s)",
      "type": "multiselect",
      "options": [
        "Superior",
        "Inferior",
        "Lateral",
        "Medial",
        "Deep"
      ],
      "default": [],
      "showIf": {
        "field": "completeness",
        "is": "Involved – which"
      }
    },
    {
      "id": "additionalNotes",
      "label": "Additional microscopy",
      "type": "textarea",
      "placeholder": "Free text appended to the microscopy for this part",
      "default": ""
    }
  ],
  "snippets": [
    {
      "id": "skin_cancer_template",
      "label": "Invasive SCC / melanoma — use the QMH skin cancer template",
      "auto": {
        "field": "diagnosis",
        "is": [
          "Invasive SCC – see comment",
          "Melanoma – see comment"
        ]
      },
      "text": "An invasive skin cancer is identified ({parts}). This benign template does not stage the lesion; the QMH skin cancer template should be used for the final synoptic report."
    }
  ],
  "example": {
    "caseTitle": "",
    "options": {
      "includeHeader": false,
      "macro": true
    },
    "parts": [
      {
        "label": "A",
        "values": {
          "specimenName": "left cheek",
          "clinicalLabel": "nodule",
          "ellipseSize": "2.5 x 1.2 x 0.6",
          "lesionSize": "0.8",
          "lesionAppearance": "Nodule",
          "orientation": "Suture at 12 o'clock = superior",
          "orientationOther": "",
          "macroMargin": "2",
          "inking": "Deep surface inked",
          "blocks": "4",
          "blockScheme": "Ellipse serially sliced and all embedded",
          "diagnosis": "Nodular basal cell carcinoma",
          "keratotic": true,
          "pni": "Absent",
          "ulceration": "Absent",
          "marginSuperior": "1.5",
          "marginInferior": "2.5",
          "marginLateral": "3.5",
          "marginMedial": "6",
          "marginDeep": "2.5",
          "completeness": "Complete",
          "involvedMargins": [],
          "additionalNotes": ""
        }
      }
    ]
  }
}
