    ],
    "fill": [
      {
        "field": "specimenName",
        "from": "detail"
      },
      {
        "field": "procedure",
        "from": "map",
        "map": [
          [
            "\\b(excision|excised|ellipse)",
            "Excision"
          ],
          [
            "\\bshav",
            "Shave"
          ],
          [
            "\\bpunch",
            "Punch"
          ],
          [
            "\\bcurett",
            "Curettings"
          ]
        ]
      }
    ]
  },
  "macroExtract": {
    "ellipseSize": {
      "concept": "specimenDims",
      "unit": "cm"
    },
    "lesionSize": {
      "concept": "tumourDims",
      "unit": "cm",
      "min": 1
    },
    "blocks": {
      "concept": "blocks",
      "unit": "count"
    },
    "blockScheme": {
      "concept": "choice",
      "map": [
        [
          "(?:serially\\s+(?:sliced|sectioned)|bisected)[^.]*all\\s+embedded|all\\s+embedded[^.]*serially",
          "Ellipse serially sliced and all embedded"
        ],
        [
          "representative\\s+(?:sections?|blocks?)|partially\\s+embedded",
          "Representative sections"
        ]
      ]
    }
  },
  "specimenNoun": "excision",
  "maxParts": 6,
  "defaultParts": 1,
  "generator": "skinexcision",
  "style": {
    "british": true
  },
  "caseFields": [],
  "options": [
    {
      "$use": "includeHeader"
    },
    {
      "id": "macro",
      "label": "Generate the macroscopic description and block key",
      "type": "checkbox",
      "default": true
    }
  ],
  "partDefaults": [],
  "fields": [
    {
      "id": "specimenName",
      "label": "Site",
      "type": "text",
      "placeholder": "left cheek",
      "default": ""
    },
    {
      "id": "procedure",
      "label": "Procedure",
      "type": "select",
      "options": [
        "Excision",
        "Shave",
        "Punch",
        "Curettings"
      ],
      "default": "Excision"
    },
    {
      "id": "clinicalLabel",
      "label": "Lesion (clinical label)",
      "type": "text",
      "placeholder": "nodule",
      "default": "nodule",
      "defaultByField": {
        "field": "procedure",
        "map": {
          "Shave": "",
          "Punch": "",
          "Curettings": ""
        }
      }
    },
    {
      "id": "ellipseSize",
      "label": "Specimen size (cm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "2.5 x 1.2 x 0.6",
      "default": ""
    },
    {
      "id": "lesionSize",
      "label": "Lesion size (cm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "0.8",
      "default": "",
      "showIf": {
        "field": "procedure",
        "not": "Curettings"
      }
    },
    {
      "id": "lesionAppearance",
      "label": "Lesion appearance",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Nodule",
        "Ulcerated nodule",
        "Ulcer",
        "Pigmented lesion",
        "Plaque",
        "Papule"
      ],
      "default": "Nodule",
      "defaultByField": {
        "field": "procedure",
        "map": {
          "Shave": "Papule",
          "Punch": "Papule"
        }
      },
      "showIf": {
        "field": "procedure",
        "not": "Curettings"
      }
    },
    {
      "id": "orientation",
      "label": "Orientation",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "None",
        "Suture at 12 o'clock = superior",
        "Other – describe"
      ],
      "default": "None",
      "showIf": {
        "field": "procedure",
        "not": [
          "Shave",
          "Punch",
          "Curettings"
        ]
      }
    },
    {
      "id": "orientationOther",
      "label": "Orientation as received",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "long suture lateral, short suture superior",
      "default": "",
      "showIf": {
        "all": [
          {
            "field": "orientation",
            "is": "Other – describe"
          },
          {
            "field": "procedure",
            "not": [
              "Shave",
              "Punch",
              "Curettings"
            ]
          }
        ]
      }
    },
    {
      "id": "macroMargin",
      "label": "Closest macroscopic margin (mm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "2",
      "default": "",
      "showIf": {
        "field": "procedure",
        "not": [
          "Shave",
          "Punch",
          "Curettings"
        ]
      }
    },
    {
      "id": "inking",
      "label": "Inking",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Deep surface inked",
        "Margins inked (see block key)",
        "Not inked"
      ],
      "default": "Deep surface inked",
      "showIf": {
        "field": "procedure",
        "not": [
          "Shave",
          "Punch",
          "Curettings"
        ]
