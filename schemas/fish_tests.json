   "reference": {
    "title": "Interphase FISH scoring criteria (break-apart rearrangements & gene amplification)",
    "intro": "Score non-overlapping tumour nuclei mapped against the matching H&E section. Confirm hybridisation efficiency on internal non-neoplastic cells before scoring.",
    "note": "Photomicrographs are from Wikimedia Commons under open Creative Commons licences. ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Break-apart rearrangement vs dual-colour amplification patterns",
      "points": [
       "Break-apart FISH (e.g. ALK, ROS1, EWSR1, SS18, MYC): positive nucleus shows split 5'/3' signals separated by >= 2 signal diameters, or an isolated 3' (typically red) signal with loss of the 5' partner. Standard ALK threshold: >= 15% of >= 50 (or 100) scored tumour nuclei.",
       "Amplification FISH (e.g. MDM2/CEP12, HER2/CEP17): report mean target signals/cell, mean centromere signals/cell, and target/centromere ratio (typically >= 2.0 or tight signal clusters = amplified)."
      ],
      "links": [
       {
        "label": "ExpertPath: Fluorescence In Situ Hybridization (FISH)",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/fish_tests/alk_breakapart.jpg",
        "caption": "ALK break-apart FISH in lung adenocarcinoma showing intact fused yellow signals alongside an isolated 3' red signal indicating ALK gene rearrangement.",
        "credit": "Manuel Medina Pérez",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Hibridaci%C3%B3n_in_situ_fluorescente_con_reordenamiento_para_ALK_(FISH_del_gen_ALK).jpg"
       },
       {
        "src": "assets/reference/fish_tests/her2_fish_amp.jpg",
        "caption": "Dual-colour HER2/CEP17 FISH demonstrating high-level gene amplification with clusters of red target signals relative to green centromere controls.",
        "credit": "Anistalista",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:HER2_FISH.jpg"
       }
      ]
     }
    ]
   }
