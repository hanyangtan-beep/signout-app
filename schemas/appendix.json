      "type": "select",
      "options": [
        "Absent",
        "Present"
      ],
      "default": "Absent"
    },
    {
      "id": "granulomas",
      "label": "Granulomas",
      "type": "select",
      "options": [
        "Absent",
        "Present - see comment"
      ],
      "default": "Absent"
    },
    {
      "id": "diverticulum",
      "label": "Diverticulum",
      "type": "select",
      "options": [
        "Absent",
        "Present"
      ],
      "default": "Absent"
    },
    {
      "id": "neoplasia",
      "label": "Neoplasia",
      "type": "select",
      "options": [
        "No dysplasia or malignancy",
        "Low grade appendiceal mucinous neoplasm (LAMN) - see comment",
        "Well differentiated neuroendocrine tumour - see comment",
        "Sessile serrated lesion",
        "Adenocarcinoma - see comment",
        "Goblet cell adenocarcinoma - see comment"
