    "diameter": {
      "concept": "diameter",
      "unit": "cm"
    },
    "blocks": {
      "concept": "blocks",
      "unit": "count"
    },
    "blockHandling": {
      "concept": "choice",
      "map": [
        [
          "\\ball\\s+(?:the\\s+tissue\\s+)?(?:is\\s+|are\\s+|been\\s+)?embedded",
          "All embedded"
        ],
        [
          "representative\\s+(?:sections?|blocks?)|partially\\s+embedded",
          "Representative sections"
        ]
      ]
    }
  },
  "specimenNoun": "appendicectomy",
  "maxParts": 2,
