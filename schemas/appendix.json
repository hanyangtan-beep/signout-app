  "fields": [
    {
      "id": "specimenName",
      "label": "Specimen as received",
      "type": "text",
      "placeholder": "Appendix / Appendix, incidental / Appendix, interval",
      "default": ""
    },
    {
      "id": "length",
      "label": "Length",
      "type": "number",
      "min": 0,
      "step": 0.1,
      "suffix": "cm",
      "default": "",
      "group": "Macroscopy"
    },
    {
      "id": "diameter",
      "label": "Diameter",
      "type": "number",
      "min": 0,
      "step": 0.1,
      "suffix": "cm",
      "default": "",
      "group": "Macroscopy"
    },
    {
      "id": "serosa",
      "label": "Serosal surface",
      "type": "select",
      "options": [
        "Congested and discoloured",
        "Smooth, glistening",
        "Fibrinopurulent exudate",
        "Perforated - site"
      ],
      "default": "Congested and discoloured",
      "group": "Macroscopy"
    },
    {
      "id": "perforationSite",
      "label": "Perforation site / size",
      "type": "text",
      "placeholder": "0.3 cm defect at the tip",
      "default": "",
