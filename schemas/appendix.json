        "Faecolith",
        "Mucus",
        "Empty",
        "Pus"
      ],
      "default": "Faecal material",
      "group": "Macroscopy"
    },
    {
      "id": "wall",
      "label": "Wall",
      "type": "select",
      "options": [
        "Unremarkable",
        "Thickened",
        "Necrotic"
      ],
      "default": "Unremarkable",
      "group": "Macroscopy"
    },
    {
      "id": "mesoappendix",
      "label": "Mesoappendix",
      "type": "select",
      "options": [
        "Included",
        "Not included"
      ],
      "default": "Included",
      "group": "Macroscopy"
    },
