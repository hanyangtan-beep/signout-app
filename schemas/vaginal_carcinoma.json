   "reference": {
    "title": "Vaginal carcinoma histologic types (WHO 5th)",
    "intro": "Primary vaginal carcinoma is diagnosed only after excluding primary cervical, vulval, or endometrial extension. HPV status separates HPV-associated from HPV-independent vaginal SCC.",
    "note": "Photomicrographs are from Wikimedia Commons under open Creative Commons licences. ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Squamous cell carcinoma (HPV-associated vs HPV-independent) & HSIL",
      "points": [
       "HPV-associated SCC: basaloid or non-keratinising nests with diffuse block-type p16 positivity and adjacent VaIN 2\u20133 (HSIL).",
       "HPV-independent SCC: keratinising nests with p16 negative/patchy and often abnormal p53."
      ],
      "links": [
       {
        "label": "ExpertPath: Vaginal Squamous Cell Carcinoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/vaginal_carcinoma/hsil_vagina.jpg",
        "caption": "High-grade squamous intraepithelial lesion (HSIL / VaIN): full-thickness atypical basaloid proliferation beside normal epithelium (H&E).",
        "credit": "Mikael H\u00e4ggstr\u00f6m",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Histopathology_of_high-grade_squamous_intraepithelial_lesion_(HSIL)_of_vulva.jpg"
       }
      ]
     },
     {
      "heading": "Clear cell carcinoma (DES-related and sporadic)",
      "points": [
       "Tubulocystic, papillary and solid patterns lined by hobnail and clear cells with glycogen-rich cytoplasm; PAX8+, HNF1B+, Napsin A+.",
       "May arise from atypical vaginal adenosis or endometriosis."
      ],
      "links": [
       {
        "label": "ExpertPath: Vaginal Clear Cell Carcinoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/vaginal_carcinoma/clear_cell_adeno.jpg",
        "caption": "Adenocarcinoma with clear cell change: glandular and solid profiles with abundant optically clear cytoplasm (H&E).",
        "credit": "Yale Rosen",
        "license": "CC BY-SA 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Adenocarcinoma_with_focal_clear_cell_change_(5765883962).jpg"
       }
      ]
     },
     {
      "heading": "Endometrioid & mucinous adenocarcinomas",
      "points": [
       "Endometrioid carcinoma often arises in vaginal endometriosis (ER+, PR+, PAX8+, vimentin+).",
       "Distinguish primary vaginal intestinal/gastric-type mucinous carcinoma from secondary spread from cervix, endometrium or colorectum."
      ],
      "links": [
       {
        "label": "ExpertPath: Vaginal Adenocarcinoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/vaginal_carcinoma/endometrioid_adeno.jpg",
        "caption": "Endometrioid adenocarcinoma: confluent back-to-back malignant glands with mucinous/squamous metaplasia (H&E).",
        "credit": "Mikael H\u00e4ggstr\u00f6m",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Histopathology_of_grade_2_endometrioid_endometrial_adenocarcinoma_with_mucinous_differentiation,_high_magnification.jpg"
       }
      ]
     }
    ]
   }
