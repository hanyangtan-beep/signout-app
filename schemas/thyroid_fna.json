 "snippets": [
  {
   "id": "thyroid_rom_i",
   "label": "Risk of malignancy: Nondiagnostic",
   "auto": {
    "field": "category",
    "is": "I. Nondiagnostic"
   },
   "text": "A nondiagnostic result (Bethesda I) carries an estimated risk of malignancy of 13% (5-20%). Repeat ultrasound-guided aspiration is suggested."
  },
  {
   "id": "thyroid_rom_iii",
   "label": "Risk of malignancy: Atypia of undetermined significance",
   "auto": {
    "field": "category",
    "is": "III. Atypia of undetermined significance"
   },
   "text": "Atypia of undetermined significance (Bethesda III) carries an estimated risk of malignancy of 22% (13-30%). Repeat aspiration, molecular testing or diagnostic lobectomy may be considered according to clinical and sonographic correlation."
  },
  {
   "id": "thyroid_rom_iv",
   "label": "Risk of malignancy: Follicular neoplasm",
   "auto": {
    "field": "category",
    "is": "IV. Follicular neoplasm"
   },
   "text": "Follicular neoplasm (Bethesda IV) carries an estimated risk of malignancy of 30% (23-34%). Diagnostic lobectomy or molecular testing is suggested; distinction between follicular adenoma, follicular carcinoma and NIFTP requires histological examination of the excised nodule."
  },
  {
   "id": "thyroid_rom_v",
   "label": "Risk of malignancy: Suspicious for malignancy",
   "auto": {
    "field": "category",
    "is": "V. Suspicious for malignancy"
   },
   "text": "Suspicious for malignancy (Bethesda V) carries an estimated risk of malignancy of 74% (67-83%). Surgical management is suggested."
  },
  {
   "id": "thyroid_molecular",
   "label": "Molecular testing available on cell block",
   "text": "Molecular testing on the cell block can be arranged on request."
  }
