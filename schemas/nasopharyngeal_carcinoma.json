   "reference": {
    "title": "WHO 5th nasopharyngeal carcinoma subtypes & EBV (EBER) testing",
    "intro": "Non-keratinising NPC (undifferentiated and differentiated subtypes) accounts for > 95% of cases in endemic areas and is strongly EBV-driven (diffuse nuclear EBER ISH positive). Always confirm EBER ISH and p16/HPV where relevant.",
    "note": "Photomicrographs are from Wikimedia Commons under open Creative Commons licences. ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Non-keratinising NPC (undifferentiated & differentiated) & EBER ISH",
      "points": [
       "Undifferentiated subtype: syncytial sheets (Regaud) or irregular anastomosing cords (Schmincke) of large cells with indistinct borders, vesicular nuclei, prominent single eosinophilic nucleoli and dense lymphoplasmacytic infiltrate.",
       "EBER ISH shows strong diffuse nuclear positivity; tumour cells are CK5/6+, p63+, p40+, and negative for lymphoid markers."
      ],
      "links": [
       {
        "label": "ExpertPath: Nasopharyngeal Carcinoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/nasopharyngeal_carcinoma/npc_nonkerat.jpg",
        "caption": "Non-keratinising nasopharyngeal carcinoma: syncytial islands of atypical epithelial cells amidst a dense lymphoid infiltrate (H&E).",
        "credit": "Nephron",
        "license": "CC BY-SA 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Nasopharyngeal_carcinoma_--_low_mag.jpg"
       },
       {
        "src": "assets/reference/nasopharyngeal_carcinoma/npc_eber.jpg",
        "caption": "Nasopharyngeal carcinoma — EBER ISH: strong, diffuse nuclear positivity in the malignant syncytial epithelial nests.",
        "credit": "Nephron",
        "license": "CC BY-SA 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Nasopharyngeal_carcinoma_-_EBER_--_high_mag.jpg"
       }
      ]
     },
     {
      "heading": "Keratinising SCC, basaloid SCC & low-grade nasopharyngeal papillary adenocarcinoma",
      "points": [
       "Keratinising SCC shows definite keratin pearls and intercellular bridges with desmoplastic stroma; EBV association is lower.",
       "Low-grade nasopharyngeal papillary adenocarcinoma (LGNPPA): arborising papillae with hyalinised cores, optically clear/grooved nuclei mimicking papillary thyroid carcinoma, TTF1+ but thyroglobulin-negative."
      ],
      "links": [
       {
        "label": "ExpertPath: Nasopharyngeal Papillary Adenocarcinoma",
        "url": "https://app.expertpath.com/"
       }
      ]
     }
    ]
