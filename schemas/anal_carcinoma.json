   "reference": {
    "title": "Anal canal & perianal carcinoma subtypes (WHO 5th)",
    "intro": "Most anal canal carcinomas are HPV-associated squamous cell carcinomas (p16 block-type positive); basaloid/cloacogenic morphology is recognised as a histological pattern within anal SCC.",
    "note": "Photomicrographs are from Wikimedia Commons under open Creative Commons licences. ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Squamous cell carcinoma & HSIL (AIN 2–3)",
      "points": [
       "Infiltrating nests and sheets of squamous cells with variable keratinisation, intercellular bridges, p16 block-type positivity and p63/p40 expression.",
       "Look for adjacent anal intraepithelial neoplasia (HSIL / AIN 2–3) in the transitional zone."
      ],
      "links": [
       {
        "label": "ExpertPath: Anal Squamous Cell Carcinoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/anal_carcinoma/anal_scc.jpg",
        "caption": "Anal epithelium progression from normal mucosa through LSIL and HSIL to invasive anal squamous cell carcinoma (H&E).",
        "credit": "Cristina Rovelli et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Histopathology_of_anal_epithelium_with_normal_histology,_low-grade_dysplasia,_high-grade_dysplasia_and_squamous_cell_carcinoma.jpg"
       },
       {
        "src": "assets/reference/anal_carcinoma/hsil_ain.jpg",
        "caption": "High-grade anal squamous intraepithelial neoplasia (AIN 2–3 / HSIL): full-thickness nuclear atypia and disorganisation (H&E).",
        "credit": "CoRus13",
        "license": "CC BY-SA 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:High-grade_anal_squamous_intraepithelial_neoplasia_(ASIN-H),_low_mag.jpg"
       }
      ]
     },
     {
      "heading": "Basaloid squamous cell carcinoma",
      "points": [
       "Lobules of basaloid cells with scant cytoplasm, peripheral nuclear palisading, central comedonecrosis and stromal retraction clefts.",
       "Diffuse p16 block-type positivity and p63/p40 expression distinguish it from neuroendocrine carcinoma."
      ],
      "links": [
       {
        "label": "ExpertPath: Basaloid Squamous Cell Carcinoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/anal_carcinoma/basaloid_scc.jpg",
        "caption": "Basaloid squamous cell carcinoma: nests of basaloid cells with peripheral palisading and surface squamous dysplasia (H&E).",
        "credit": "Samir K El-Mofty",
        "license": "CC BY 2.5",
        "url": "https://commons.wikimedia.org/wiki/File:Histopathology_of_basaloid_squamous_cell_carcinoma.png"
       }
      ]
     },
     {
      "heading": "Verrucous squamous cell carcinoma",
      "points": [
       "Exophytic papillomatous proliferation of bland, well-differentiated keratinising squamous epithelium invading on a broad pushing front with bulbous rete pegs.",
       "Usually HPV-negative / low-risk HPV 6/11 (giant condyloma of Buschke-Lowenstein)."
      ],
      "links": [
       {
        "label": "ExpertPath: Verrucous Carcinoma",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/anal_carcinoma/verrucous_ca.jpg",
        "caption": "Verrucous carcinoma: papillomatosis, acanthosis and broad pushing bulbous nests (illustrated in anogenital site, H&E).",
        "credit": "Prodromos Philippou et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Micrograph_of_penile_verrucous_carcinoma_-_20x.jpg"
       }
      ]
     },
     {
      "heading": "Anal adenocarcinoma & perianal Paget disease",
      "points": [
       "True anal gland adenocarcinoma (CK7+, CK20-, CDX2-) must be distinguished from low rectal adenocarcinoma extending into the anal canal (CK20+, CDX2+).",
       "Perianal Paget disease may be primary cutaneous (CK7+, GCDFP15+) or secondary to colorectal adenocarcinoma (CK20+, CDX2+)."
      ],
      "links": [
       {
        "label": "ExpertPath: Anal Adenocarcinoma & Paget Disease",
        "url": "https://app.expertpath.com/"
       }
      ],
      "images": [
       {
        "src": "assets/reference/anal_carcinoma/anal_paget.jpg",
        "caption": "Extramammary Paget disease: large pale intraepithelial cells with clear cytoplasm in the epidermis (H&E).",
        "credit": "Nephron",
        "license": "CC BY-SA 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Extramammary_Paget_disease_-_low_mag.jpg"
       }
      ]
     }
    ]
   }
