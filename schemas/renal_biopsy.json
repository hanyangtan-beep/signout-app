   "reference": {
    "title": "Medical renal biopsy scoring: Oxford MEST-C, ISN/RPS 2018 & Banff 2022",
    "intro": "Report glomerular counts (total, globally sclerosed, segmentally sclerosed, crescents), IFTA %, immunofluorescence intensities (0–3+), electron microscopy ultrastructure, and disease-specific scores.",
    "note": "ExpertPath pages open with your own ExpertPath login; the app holds none of their images.",
    "groups": [
     {
      "heading": "Key scoring systems",
      "points": [
       "IgA nephropathy (Oxford MEST-C): M0/M1 (mesangial hypercellularity > 50% gloms), E0/E1 (endocapillary), S0/S1 (segmental sclerosis), T0 (<=25%)/T1 (26–50%)/T2 (>50% IFTA), C0/C1 (<25%)/C2 (>=25% crescents).",
       "Lupus nephritis (ISN/RPS 2018): Classes I–VI + modified NIH Activity Index (/24) and Chronicity Index (/12).",
       "Transplant allograft (Banff 2022): Adequacy >= 10 glomeruli & >= 2 arteries; score i, t, v, g, ptc, ci, ct, cv, cg, ah, ti, i-IFTA, C4d (IF >= 2 or IHC >= 1 = positive), SV40/pvl."
      ],
      "links": [
       {
        "label": "ExpertPath: Medical Renal Diseases & Allograft Pathology",
        "url": "https://app.expertpath.com/"
       }
      ]
     }
    ]
   }
