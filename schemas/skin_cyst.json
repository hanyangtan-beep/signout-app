{
  "id": "skin_cyst",
  "version": "2026.10",
  "name": "Skin cyst",
  "shortName": "Skin · cyst excision",
  "label": "Skin cyst",
  "organ": "SKIN",
  "system": "Skin",
  "kind": "benign resection",
  "rank": 29,
  "aliases": [
    "sebaceous cyst",
    "seb cyst",
    "epidermal cyst",
    "epidermoid",
    "inclusion cyst",
    "pilar cyst",
    "trichilemmal",
    "dermoid",
    "ruptured cyst",
    "keratin",
    "steatocystoma",
    "granulomatous reaction"
  ],
  "match": {
    "site": [
      "skin",
      "scalp",
      "face",
      "ear",
      "forehead",
      "cheek"
    ],
    "procedure": [
      "excision",
      "excision biopsy",
      "enucleation"
    ],
    "clinical": [
      "sebaceous cyst",
      "seb cyst",
      "epidermal cyst",
      "epidermoid cyst",
      "inclusion cyst",
      "pilar cyst",
      "trichilemmal",
      "dermoid",
      "cyst",
      "infected cyst"
    ],
    "fill": [
      {
        "field": "specimenName",
        "from": "detail",
        "fallback": "text",
        "strip": "^(?!.*lid\\s+margin)(?!.*\\b(?:anal|costal)\\s+margin)\\s*(?:\\S+\\s+){0,3}margins?(?:\\s+\\w{1,2}|\\s+(?:on|of|from|at)\\b.*)?\\s*$|^\\s*\\?\\s*|^\\s*(?:skin\\s+)?(?:(?:sebac\\w*|seb|epidermoid|epidermal|pilar|tri\\w*lemmal|infected|inflamed|ruptured|recurrent|pigmented)\\s+)*(?:cysts?|keratos[ie]s|SK|lesions?|nodules?|warts?|naev[iu]s|nev[iu]s|moles?|BCC|SCC)\\s+(?:(?:at|over|on|of|from|in)\\s+(?:the\\s+)?)?(?!(?:wall|contents?|lining|excision|incision\\w*|biops\\w*|with|and|x)\\b)(?=[A-Za-z])|\\b(?:skin(?:\\s+and)?|excision(?:al)?\\s+biops(?:y|ies)|incision(?:al)?\\s+biops(?:y|ies)|wide\\s+(?:local\\s+)?excision|re-?excision|excisional|excision|excised|incisional|incision|ellipse|shave(?:\\s+biopsy)?|punch(?:\\s+biopsy)?|curett(?:ings?|age)|biops(?:y|ies)|debrided|debridement)\\b|(?:\\(\\s*)?(?:\\?|\\b(?:\\d+(?:\\.\\d+)?\\s*(?:mm|cm)\\b|\\d+(?:\\.\\d+)?\\s*x\\s*\\d|x\\s*\\d+\\b|lesions?|lestions?|nodules?|nodular|mass(?:es)?|lumps?|swellings?|cysts?|cystic|sebac\\w*|seb|epidermoid|epidermal|pilar|tri\\w*lemmal|dermoid|cutaneous|subcut\\w*|eccrine|apocrine|papillomas?|tags?|polyps?|warts?|viral|verruca\\w*|seborrh?o?eic|keratos[ie]s|keratotic|actinic|AK|SK|naev[iu]s|naevi|nev[iu]s|nevi|moles?|pigmented|melanocytic|BCC|SCC|basal|squamous|(?!stomas?\\b)\\w+omas?|\\w+itis|DFSP|pyogenic|scars?|keloid|ulcers?|ulcerated|venous|tumou?rs?|growths?|papules?|plaques?|patch(?:es)?|rash|erythematous|vascular|induration|indurated|perilesional|blister\\w*|abscess\\w*|chronic|xanthelasma|Bowen\\S*|corns?|callus|horn|stitch\\w*|sttich\\w*|stich\\w*|(?:short|long)(?=(?:\\s+(?:and\\s+)?(?:short|long))*\\s+(?:stitch|suture|sttich|stich))|sutures?|previously|infected|inflamed|recurrent|ruptured|superficial|suspicious|suspected|query|multiple|tissue|further|resection)\\b).*$",
        "dedupe": true,
        "lower": true
      }
    ]
  },
  "macroExtract": {
    "ellipseSize": {
      "concept": "specimenDims",
      "unit": "cm"
    },
    "noduleSize": {
      "concept": "tumourDims",
      "unit": "cm",
      "min": 1
    },
    "blocks": {
      "concept": "blocks",
      "unit": "count"
    },
    "blockScheme": {
      "concept": "choice",
      "map": [
        [
          "\\ball\\s+(?:the\\s+tissue\\s+)?(?:is\\s+|are\\s+|been\\s+)?embedded",
          "All embedded"
        ],
        [
          "representative\\s+(?:sections?|blocks?)|partially\\s+embedded",
          "Representative sections"
        ]
      ]
    }
  },
  "specimenNoun": "excision",
  "maxParts": 3,
  "defaultParts": 1,
  "generator": "skincyst",
  "style": {
    "british": true
  },
  "caseFields": [],
  "options": [
    {
      "$use": "includeHeader"
    },
    {
      "id": "macro",
      "label": "Generate the macroscopic description and block key",
      "type": "checkbox",
      "default": true
    }
  ],
  "partDefaults": [],
  "fields": [
    {
      "id": "specimenName",
      "label": "Site",
      "type": "text",
      "placeholder": "right axilla",
      "default": ""
    },
    {
      "id": "clinicalLabel",
      "label": "Clinical label",
      "type": "text",
      "placeholder": "seb cyst",
      "default": "seb cyst"
    },
    {
      "id": "ellipseSize",
      "label": "Ellipse of skin (cm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "3 x 1.5",
      "default": ""
    },
    {
      "id": "noduleSize",
      "label": "Nodule (cm)",
      "type": "text",
      "group": "Macroscopy",
      "placeholder": "1.5",
      "default": ""
    },
    {
      "id": "deepInked",
      "label": "Deep surface",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Inked",
        "Not inked"
      ],
      "default": "Inked"
    },
    {
      "id": "cystContents",
      "label": "Cyst contents",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "Cheesy keratinous material",
        "Hair and sebaceous material",
        "Ruptured"
      ],
      "default": "Cheesy keratinous material"
    },
    {
      "id": "blocks",
      "label": "Blocks",
      "type": "number",
      "group": "Macroscopy",
      "min": 1,
      "step": 1,
      "default": "2"
    },
    {
      "id": "blockScheme",
      "label": "Sampling",
      "type": "select",
      "group": "Macroscopy",
      "options": [
        "All embedded",
        "Representative sections"
      ],
      "default": "All embedded"
    },
    {
      "id": "cystType",
      "label": "Cyst type",
      "type": "select",
      "options": [
        "Epidermal cyst",
        "Pilar (trichilemmal) cyst",
        "Dermoid cyst",
        "Hybrid cyst",
        "Ruptured cyst with no residual lining",
        "Steatocystoma"
      ],
      "default": "Epidermal cyst"
    },
    {
      "id": "rupture",
      "label": "Rupture with granulomatous reaction",
      "type": "select",
      "options": [
        "Absent",
        "Present"
      ],
      "default": "Absent"
    },
    {
      "id": "giantCells",
      "label": "Foreign body giant cells",
      "type": "select",
      "options": [
        "Absent",
        "Present"
      ],
      "default": "Absent"
    },
    {
      "id": "acuteInflammation",
      "label": "Acute inflammation / abscess",
      "type": "select",
      "options": [
        "Absent",
        "Present",
        "Abscess formation"
      ],
      "default": "Absent"
    },
    {
      "id": "neoplasia",
      "label": "Neoplasia",
      "type": "select",
      "options": [
        "No evidence of malignancy",
        "Proliferating trichilemmal tumour – see comment",
        "Malignancy – see comment"
      ],
      "default": "No evidence of malignancy"
    },
    {
      "id": "excision",
      "label": "Excision",
      "type": "select",
      "options": [
        "Complete",
        "Incomplete",
        "Not assessable"
      ],
      "default": "Complete"
    },
    {
      "id": "additionalNotes",
      "label": "Additional microscopy",
      "type": "textarea",
      "placeholder": "Free text appended to the microscopy for this part",
      "default": ""
    }
  ],
  "snippets": [
    {
      "id": "skin_cyst_cancer_template",
      "label": "Neoplasia in cyst — use the QMH skin cancer template",
      "auto": {
        "field": "neoplasia",
        "not": "No evidence of malignancy"
      },
      "text": "A neoplastic proliferation is identified in the cyst ({parts}). This benign template does not grade or stage the lesion; the QMH skin cancer template should be used for the final synoptic report."
    }
  ],
  "example": {
    "caseTitle": "",
    "options": {
      "includeHeader": false,
      "macro": true
    },
    "parts": [
      {
        "label": "A",
        "values": {
          "specimenName": "right axilla",
          "clinicalLabel": "seb cyst",
          "ellipseSize": "3 x 1.5",
          "noduleSize": "1.5",
          "deepInked": "Inked",
          "cystContents": "Cheesy keratinous material",
          "blocks": "2",
          "blockScheme": "All embedded",
          "cystType": "Epidermal cyst",
          "rupture": "Absent",
          "giantCells": "Absent",
          "acuteInflammation": "Absent",
          "neoplasia": "No evidence of malignancy",
          "excision": "Complete",
          "additionalNotes": ""
        }
      }
    ]
  }
}
