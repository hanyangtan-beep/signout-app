  "kind": "biopsy",
  "rank": 5,
  "aliases": [
    "ulcerative colitis",
    "Crohn",
    "colitis",
    "chronic colitis",
    "terminal ileum",
    "ileum",
    "surveillance",
    "mapping",
    "inflammatory bowel disease"
  ],
  "specimenNoun": "biopsy",
  "maxParts": 12,
  "defaultParts": 1,
  "generator": "ibd",
  "style": {
    "british": true
  },
  "caseFields": [],
  "options": [
    {
      "id": "includeHeader",
      "label": "Section headers (SPECIMEN / MICROSCOPIC EXAMINATION / DIAGNOSIS)",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "summary",
      "label": "Distribution summary and IBD pattern interpretation after the diagnosis",
      "type": "checkbox",
      "default": true
    },
    {
      "id": "nancy",
      "label": "Nancy histological index per site",
      "type": "checkbox",
      "default": false
    }
  ],
  "partDefaults": [
    {
      "site": "Terminal ileum"
    },
    {
      "site": "Caecum"
    },
    {
      "site": "Ascending colon"
    },
    {
      "site": "Transverse colon"
    },
    {
      "site": "Descending colon"
    },
    {
      "site": "Sigmoid colon"
    },
    {
      "site": "Rectum"
    }
  ],
  "fields": [
    {
      "id": "site",
      "label": "Site",
      "type": "select",
      "options": [
        "Terminal ileum",
        "Ileocaecal valve",
        "Caecum",
        "Ascending colon",
        "Hepatic flexure",
        "Transverse colon",
        "Splenic flexure",
        "Descending colon",
        "Sigmoid colon",
        "Rectosigmoid",
        "Rectum",
        "Random colon"
      ],
      "default": "Rectum"
    },
    {
      "id": "villi",
      "label": "Villous architecture",
      "type": "select",
      "options": [
        "Preserved",
        "Blunted"
      ],
      "default": "Preserved",
      "showIf": {
        "field": "site",
        "is": [
          "Terminal ileum",
          "Ileocaecal valve"
        ]
      }
    },
    {
      "id": "distortion",
      "label": "Crypt architectural distortion",
      "type": "grade",
      "options": [
        "Absent",
        "Mild",
        "Moderate",
        "Marked"
      ],
      "default": "Absent"
    },
    {
      "id": "basalPlasma",
      "label": "Basal plasmacytosis",
      "type": "select",
      "options": [
        "Absent",
        "Focal",
        "Diffuse"
      ],
      "default": "Absent"
    },
    {
      "id": "chronic",
      "label": "Lamina propria chronic inflammation",
      "type": "grade",
      "options": [
        "Normal",
        "Mild",
        "Moderate",
        "Marked"
      ],
      "default": "Normal"
    },
    {
      "id": "activity",
      "label": "Activity (neutrophils)",
      "type": "grade",
      "options": [
        "Absent",
        "Mild",
        "Moderate",
        "Severe"
      ],
      "optionLabels": {
        "Mild": "Mild (cryptitis)",
        "Moderate": "Moderate (crypt abscesses)",
        "Severe": "Severe (erosion / ulceration)"
      },
      "default": "Absent"
    },
    {
      "id": "granulomas",
      "label": "Granulomas",
      "type": "select",
      "options": [
        "Absent",
        "Crypt-rupture associated",
        "Present, not crypt-associated"
      ],
      "default": "Absent"
    },
    {
      "id": "metaplasia",
      "label": "Metaplasia",
      "type": "select",
      "options": [
        "Absent",
        "Paneth cell metaplasia",
        "Pyloric gland metaplasia",
        "Both"
      ],
      "default": "Absent",
      "help": "Paneth cells distal to the hepatic flexure and pyloric glands in the ileum or colon are chronicity markers."
    },
    {
      "id": "dysplasia",
      "label": "Dysplasia",
      "type": "select",
      "options": [
        "No dysplasia",
        "Indefinite for dysplasia",
        "Low grade dysplasia",
        "High grade dysplasia"
      ],
      "default": "No dysplasia"
    },
    {
      "id": "additionalNotes",
      "label": "Additional notes",
      "type": "textarea",
      "default": "",
      "placeholder": "Appended to the microscopy for this part"
    }
  ],
