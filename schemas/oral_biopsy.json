      "reference": {
        "title": "Oral epithelial dysplasia and carcinoma (WHO 5th edition)",
        "intro": "WHO 5th edition keeps the three-tier grade (mild, moderate, severe) as its primary scheme and acknowledges the binary one (low, high); the house prints the binary grade. Grade on the architectural and cytological features, not on epithelial thirds alone.",
        "columns": 2,
        "groups": [
          {
            "heading": "Low grade dysplasia",
            "points": [
              "Irregular stratification, basal cell crowding and loss of basal polarity",
              "Drop-shaped rete ridges; nuclear enlargement and hyperchromasia",
              "Binary scheme (Kujan): up to 4 architectural and up to 5 cytological features",
              "Three-tier equivalent: mild, and most moderate, dysplasia"
            ],
            "images": [
              {
                "src": "assets/reference/oral/dysplasia_low_grade.jpg",
                "caption": "Low-grade dysplasia",
                "credit": "Lorini et al., Cancers 2021, Fig 2C (cropped)",
                "license": "CC BY 4.0",
                "url": "https://www.mdpi.com/2072-6694/13/15/3696"
              }
            ]
          },
          {
            "heading": "High grade dysplasia",
            "points": [
              "More than 4 architectural and more than 5 cytological features (Kujan)",
              "Marked pleomorphism, atypical mitoses, mitoses high in the epithelium, single-cell keratinisation",
              "Cytological atypia can upgrade change confined to the basal third",
              "Carcinoma in situ is treated as synonymous with severe dysplasia (WHO 5th)"
            ],
            "images": [
              {
                "src": "assets/reference/oral/dysplasia_high_grade.jpg",
                "caption": "High-grade dysplasia / carcinoma in situ",
                "credit": "Lorini et al., Cancers 2021, Fig 2D (cropped)",
                "license": "CC BY 4.0",
                "url": "https://www.mdpi.com/2072-6694/13/15/3696"
              }
            ]
          },
          {
            "heading": "Invasive squamous cell carcinoma",
            "points": [
              "Nests and cords of atypical squamous cells breach the basement membrane into the lamina propria",
              "Desmoplastic or inflammatory stromal reaction around the invading nests",
              "Grade on the least differentiated area: well, moderately or poorly differentiated",
              "A superficial biopsy gives neither the depth of invasion nor the worst pattern of invasion"
            ],
            "images": [
              {
                "src": "assets/reference/oral/scc_invasive.jpg",
                "caption": "Infiltrating squamous cell carcinoma",
                "credit": "Lorini et al., Cancers 2021, Fig 2E (cropped)",
                "license": "CC BY 4.0",
                "url": "https://www.mdpi.com/2072-6694/13/15/3696"
              },
              {
                "src": "assets/reference/oral/scc_well_differentiated.jpg",
                "caption": "Well-differentiated squamous cell carcinoma, excisional biopsy",
                "credit": "KGH, Wikimedia Commons (resized)",
                "license": "CC BY-SA 3.0",
                "url": "https://commons.wikimedia.org/wiki/File:Oral_cancer_(1)_squamous_cell_carcinoma_histopathology.jpg"
              }
            ]
          },
          {
            "heading": "Lichen planus (mimic)",
            "points": [
              "Band-like lymphocytic infiltrate confined to the epithelium-lamina propria interface",
              "Basal cell hydropic degeneration and lymphocytic exocytosis",
              "No dysplasia and no verrucous architecture (AAOMP 2016)",
              "Proliferative verrucous leukoplakia keeps intact basal cells or shows dysplasia"
            ],
            "images": [
              {
                "src": "assets/reference/oral/lichen_planus.jpg",
                "caption": "Oral lichen planus",
                "credit": "Lorini et al., Cancers 2021, Fig 2A (cropped)",
                "license": "CC BY 4.0",
                "url": "https://www.mdpi.com/2072-6694/13/15/3696"
              }
            ]
          }
        ]
      }
